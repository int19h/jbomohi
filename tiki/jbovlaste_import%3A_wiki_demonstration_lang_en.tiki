This relates to [http://www.lojban.org/jbovlaste/help/wikitext.html|the wiki  text help file].

!!General Wiki Formatting

' 'string' '%%%
''string''

_ _string_ _%%%
__string__

' ' 'string' ' '%%%
'''string'''

break% % %break%%%
break%%%break

 =pre formmatted string
=pre     formatted     no
=    space         amount
=            changing      done

 * item%%%
 ** item%%%
 *** item%%%
* item
** item
*** item

 # item%%%
 ## item%%%
 ### item%%%
 # item%%%
# item
## item
### item
# item

 ------
------

 !!!!heading
!!!heading

 ;def term:def desc
;def term:def desc

 | aaaaa | bb | ccccc%%%
 | aa | bbbbbbbbbbb | cc
| aaaaa | bb | ccccc
| aa | bbbbbbbbbbb | cc

!!Internal Word Link Format (~np~{}~/np~ links)
~np~{valsi}~/np~%%%
{jvsv prami}

~np~{valsi|alt}~/np~%%%
NOT HANDLED: ~np~{prami|running}~/np~

~np~{valsi:d}~/np~%%%
NOT HANDLED: ~np~{prami:d}~/np~

~np~{valsi:g}~/np~%%%
{jvsv prami general=1}

~np~{valsi:w}~/np~%%%
NOT HANDLED: ~np~{prami:w}~/np~

~np~{valsi:p}~/np~%%%
NOT HANDLED: ~np~{samru'e:p}~/np~

~np~{valsi:1)%%%
NOT HANDLED: ~np~{samru'e:1}~/np~

~np~{valsi:2}~/np~%%%
{samru'e:2}~/np~

~np~{valsi:3}~/np~%%%
NOT HANDLED: ~np~{samru'e:3}~/np~

~np~{valsi:4}~/np~%%%
NOT HANDLED: ~np~{samru'e:4}~/np~

~np~{valsi:5}~/np~%%%
NOT HANDLED: ~np~{samru'e:5}~/np~

~np~{valsi:6}~/np~%%%
NOT HANDLED: ~np~{samru'e:6}~/np~

~np~{word!}~/np~%%%
{jvsn computer process general=1}

~np~{word!lang}~/np~%%%
{jvsn amanto lang="eo" general=1}

~np~{word!!}~/np~%%%
{jvsn computer process meaning="" general=1}

~np~{word!meaning!}~/np~%%%
{jvsn process meaning="computer process" general=1}

~np~{word!!lang}~/np~%%%
NOT HANDLED: ~np~{amanto!!eo}~/np~

~np~{word!meaning!lang}~/np~%%%
NOT HANDLED: ~np~{mango!fruta!es}~/np~

~np~{valsi||lang}~/np~%%%
NOT HANDLED: ~np~{punji||es}~/np~

~np~{valsi|alt|lang}~/np~%%%
NOT HANDLED: ~np~{punji|Spanish Entry For punji|es}~/np~

~np~{valsi:args||lang}~/np~%%%
NOT HANDLED: ~np~{punji:d||es}~/np~

!!Wiki Link Format (~np~[]~/np~ links)

~np~[page]~/np~%%%
((jbovlaste import: FrontPage lang en))

~np~[page|link]~/np~%%%
((jbovlaste import: FrontPage|Main English Page lang en))

~np~[page||lang]~/np~%%%
NOT HANDLED: ~np~[FrontPage||eo]~/np~

~np~[page|alt|lang]~/np~%%%
NOT HANDLED: ~np~[FrontPage|Main Esperanto Page|eo]~/np~

~np~[page|alt||lang]~/np~%%%
NOT HANDLED: ~np~[FrontPage|Main Esperanto Page||eo]~/np~

~np~[url!alt]~/np~%%%
[http://www.lojban.org/jbovlaste/help/wikitext.html|the wiki  text help file]

~np~[url!]~/np~%%%
[http://www.lojban.org/jbovlaste/help/wikitext.html]





