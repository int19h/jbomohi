FUhO <- &CMAVO ( f u h o ) post-cmavo 

GA <- &CMAVO ( g e h i / g e / g o / g a / g u ) post-cmavo 

GAhO <- &CMAVO ( k e h i / g a h o ) post-cmavo 

GEhU <- &CMAVO ( g e h u ) post-cmavo 

GI <- &CMAVO ( g i ) post-cmavo 

