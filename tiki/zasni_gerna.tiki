;------------------------------------------------------------------- 

CMENE <- jbocme / zifcme 

jbocme <- &zifcme syllable+ &pause 

zifcme <- (phoneme !pause)* C &pause

;------------------------------------------------------------------- 

CMAVO <- !cmene !CVCy-lujvo C? glide? (nucleus h)* nucleus &post-cmavo / y+

CVCy-lujvo <- C V C y h? initial-rafsi* (type-3 / fuhivla / gismu / end-rafsi) 

post-cmavo <- pause / !nucleus (CMAVO / BRIVLA) 

;------------------------------------------------------------------- 

BRIVLA <- gismu / fuhivla / type-3 / lujvo  

;-----------------------------------

lujvo <- !cmavo initial-rafsi+ (type-3 / fuhivla / gismu / end-rafsi)

initial-rafsi <- brivla-rafsi / type-3-rafsi / fuhivla-rafsi / y-rafsi / !fuhivla !type-3 y-less-rafsi 

brivla-rafsi <- !cmene !cmavo !slinkuhihy !h V-syllable V-syllable+ h y h? 

slinkuhihy <- slinkuhi h y 

;-----------------------------------

type-3 <- !cmene (C V C C / CC V C / C V C) y? (r / n / l) &C V-syllable+ &pause 

type-3-rafsi <- !cmene (C V C C / CC V C / C V C) y? (r / n / l) &C V-syllable* y-syllable h? 

;-----------------------------------

fuhivla <- !cmene !cmavo !rafsi-string !slinkuhi !h V-syllable V-syllable+ &pause 

fuhivla-rafsi <- !cmene !cmavo !rafsi-string !slinkuhi !h V-syllable+ y-syllable h? 

slinkuhi <- C rafsi-string 

rafsi-string <- y-less-rafsi* (gismu / end-rafsi / y-rafsi / CC y) 

;-----------------------------------

gismu <- (C V C C V / CC V C V) &pause 

;-----------------------------------

end-rafsi <- (C V h V / C VV / CC V) &pause 

y-rafsi <- (C V C C / CC V C / C V C) y h? 

y-less-rafsi <- (C V C !y / CC V / C VV R? / C V h V R?) !fuhivla !type-3 !brivla-rafsi !type-3-rafsi !fuhivla-rafsi 

R <- r &C / n &r 

;------------------------------------------------------------------- 

syllable <- onset nucleus coda?

y-syllable <- onset y coda? 

V-syllable <- onset V coda?

coda <- !syllable C 

onset <- h / C? glide / initial

initial <- (affricate / sibilant? middle? liquid?) &nucleus

sibilant <- c / s !x / (j / z) !n !l !r 

middle <- p / t !l / k / f / x / b / d !l / g / v / m / n !l !r 

liquid <- l / r 

;--------------------------------------------------------------- 

phoneme <- V / VV / y / glide / h / C 


;************************ 

; PHONOLOGY  

; the above has terminals a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, r, s, t, u, v, x, y, z,

; V, VV, glide, C, affricate, nucleus, pause, spaces, dot-star and EOF ...
 
;************************ 

;-------------------------------------

C <- voiced / unvoiced / l / m / n / r 

affricate <- t c / t s / d j / d z 

voiced <- b / d / g / j / v / z 

unvoiced <- c / f / k / p / s / t / x 

l <- [[l] !h !l 

m <- [[m] !h !m !z 

n <- [[n] !h !n !affricate 

r <- [[r] !h !r 

b <- [[b] !h !b !unvoiced 

d <- [[d] !h !d !unvoiced 

g <- [[g] !h !g !unvoiced 

v <- [[v] !h !v !unvoiced 

j <- [[j] !h !j !z !unvoiced 

z <- [[z] !h !z !j !unvoiced 

s <- [[s] !h !s !c !voiced 

c <- [[c] !h !c !s !x !voiced 

x <- [[x] !h !x !c !k !voiced 

k <- [[k] !h !k !x !voiced 

f <- [[f] !h !f !voiced 

p <- [[p] !h !p !voiced 

t <- [[t] !h !t !voiced 

h <- [['h] &nucleus

;----------------------------------------

glide <- (i / u) &nucleus

nucleus <- V / VV / y

VV <- (a i / a u / e i / o i) !nucleus !glide 

V <- (a / e / i / o / u) !nucleus 

a <- [[a] 

e <- [[e] 

i <- [[i] 

o <- [[o] 

u <- [[u] 

y <- [[y] !nucleus

;------------------------------------------------------------------- 

ybu <- Y space-char* BU 

spaces <- !Y initial-spaces 

initial-spaces <- (space-char / !ybu Y)+ EOF? / EOF 

pause <- space-char+ / EOF 

NORATS non-space <- !space-char . 

NORATS space-char <- [[.\t\n\r?!\u0020] 

EOF <- !. 

SPACE dot-star <- .* 

