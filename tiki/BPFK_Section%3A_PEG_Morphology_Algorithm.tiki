; This is a Parsing Expression Grammar for the morphology of Lojban.
; See http://www.pdos.lcs.mit.edu/~baford/packrat/
; 
; All rules have the form:
; 
; 	name <- peg-expression
; 
; which means that the grammatical construct "name" is parsed using
; "peg-expression".  
; 
; 1)  Concatenation is expressed by juxtaposition with no operator symbol.
; 2)  / represents *ORDERED* alternation (choice).  If the first
;     option succeeds, the others will never be checked.
; 3)  ? indicates that the element to the left is optional.
; 4)  * represents optional repetition of the construct to the left.
; 5)  + represents one-or-more repetition of the construct to the left.
; 6)  () serves to indicate the grouping of the other operators.
; 7)  & indicates that the element to the right must follow (but the
;     marked element itself does not absorb anything).
; 8)  ! indicates that the element to the right must not follow (the
;     marked element itself does not absorb anything).
; 9)  . represents any character.
; 10) ' ' or " " represents a literal string.
; 11) [] represents a character class.    
;
; Repetitions grab as much as they can.
;
;
; --- GRAMMAR ---
; This grammar classifies words by their morphological class (cmene,
; gismu, lujvo, fuhivla, cmavo, and non-lojban-word). It does not sort
; them into grammatical classes (CMENE, BRIVLA, A, BAI, BAhE, ..., ZOhU).
;
; (Not properly tested yet.)
;
; mi'e ((xorxes))

;-------------------------------------------------------------------

words <- (space* word)* space* EOF

word <- cmene / gismu / lujvo / fuhivla / cmavo / non-lojban-word

;-------------------------------------------------------------------

cmene <- cmene-syllaboid* consonant+ &space

cmene-syllaboid <- !doi-la-lai-lahi consonant* vowel-y (h? vowel-y)*

doi-la-lai-lahi <- (d o i / l a (h? i)?) &consonant

;-------------------------------------------------------------------

cmavo <- consonant? vowel-y (h? vowel-y)*

;-------------------------------------------------------------------

gismu <- (initial-pair vowel / consonant vowel consonant) consonant vowel &space / stressed-gismu

stressed-gismu <- (initial-pair stressed-vowel / consonant stressed-vowel consonant) consonant vowel &(space / consonant)

;-------------------------------------------------------------------

fuhivla <- fuhivla-head non-initial-cluster fuhivla-tail / fuhivla-head initial-cluster syllable &space / !(consonant lujvo) !(consonant final-rafsi) initial-cluster syllable fuhivla-tail / fuhivla-head non-initial-cluster stressed-fuhivla-tail / stressed-fuhivla-head (initial-cluster / non-initial-cluster) syllable &(space / consonant) / !(consonant lujvo) !(consonant final-rafsi) initial-cluster stressed-fuhivla-tail

stressed-fuhivla-tail <- syllable* stressed-syllable syllable &(space / consonant)

stressed-fuhivla-head <- consonant? (stressed-diphthong / (vowel h?)? stressed-vowel) / (diphthong h?)? stressed-vowel / (vowel h?)? stressed-diphthong / (vowel h?)? (vowel h?)? stressed-vowel

stressed-syllable <- (consonant+ / h?) (stressed-diphthong / stressed-vowel)

fuhivla-tail <- syllable+ &space

fuhivla-head <- consonant? vowel (h? vowel)? / vowel (h? vowel)? (h? vowel)?

syllable <- (consonant+ / h?) (diphthong / vowel)

;-------------------------------------------------------------------

lujvo <- CVV-rafsi CCV-rafsi &space / !(cmavo lujvo) initial-rafsi medial-rafsi* final-rafsi / stressed-last-CVV-rafsi CCV-rafsi &(space / consonant) / !(cmavo lujvo) initial-rafsi medial-rafsi* stressed-final-rafsi / !(cmavo lujvo) stressed-initial-rafsi short-final-rafsi / !(cmavo lujvo) initial-rafsi medial-rafsi* stressed-medial-rafsi short-final-rafsi

stressed-initial-rafsi <- stressed-long-rafsi / stressed-CVC-rafsi / stressed-CCV-rafsi / stressed-last-CVV-rafsi r / stressed-last-CVV-rafsi n &r

stressed-medial-rafsi <- !gismu (stressed-long-rafsi / stressed-CVC-rafsi / stressed-CCV-rafsi / stressed-last-CVV-rafsi) &consonant

stressed-final-rafsi <- stressed-gismu / stressed-first-CVV-rafsi &(space / consonant)

short-final-rafsi <- (short-CVV-rafsi / CCV-rafsi) &(space / consonant)

short-CVV-rafsi <- consonant rafsi-diphthong

stressed-first-CVV-rafsi <- consonant stressed-vowel h vowel

stressed-last-CVV-rafsi <- consonant (vowel h stressed-vowel / stressed-rafsi-diphthong)

stressed-CCV-rafsi <- initial-pair stressed-vowel

stressed-CVC-rafsi <- consonant stressed-vowel !(n t c) !(n t s) !(n d j) !(n d z) consonant y?

stressed-long-rafsi <- (initial-pair stressed-vowel / consonant stressed-vowel consonant) consonant y

initial-rafsi <- long-rafsi / CVC-rafsi / CCV-rafsi / CVV-rafsi r / CVV-rafsi n &r

medial-rafsi <- !gismu (long-rafsi / CVC-rafsi / CCV-rafsi / CVV-rafsi) &consonant

final-rafsi <- (gismu / CVV-rafsi / CCV-rafsi) &space

CVV-rafsi <- consonant (vowel h vowel / rafsi-diphthong)

CCV-rafsi <- initial-pair vowel

CVC-rafsi <- consonant vowel !(n t c) !(n t s) !(n d j) !(n d z) consonant y?

long-rafsi <- (initial-pair vowel / consonant vowel consonant) consonant y

;-------------------------------------------------------------------

vowel-y <- a / e / i / o / u / y

stressed-diphthong <- [[iIuU][[AEIOU] comma* / stressed-rafsi-diphthong
stressed-rafsi-diphthong <- [[AEO][[iI] comma* / [[A][[uU] comma*
stressed-vowel <- [[AEIOU] comma*
diphthong <- [[iu][[aeiou] comma* / rafsi-diphthong
rafsi-diphthong <- [[aeo][[i] comma* / [[a][[u] comma*
vowel <- [[aeiou] comma*

a <- [[aA] comma*
e <- [[eE] comma*
i <- [[iI] comma*
o <- [[oO] comma*
u <- [[uU] comma*
y <- [[yY] comma*

;-------------------------------------------------------------------

non-initial-cluster <- !initial-cluster consonant consonant+
initial-cluster <- initial-consonant+ consonant !consonant
initial-pair <- initial-consonant consonant !consonant
initial-consonant <- c / s / j !n / z !n / d-t &sibilant / !l !n consonant &r / !r !n !d-t consonant &l
consonant <- voiced-consonant / unvoiced-consonant / l / m / n / r
voiced-consonant <- b / d / g / j / v / z
unvoiced-consonant <- c / f / k / p / s / t / x
sibilant <- c / j / s / z
d-t <- d / t

l <- [[lL] comma* !h !l
m <- [[mM] comma* !h !m !z
n <- [[nN] comma* !h !n
r <- [[rR] comma* !h !r
b <- [[bB] comma* !h !b !unvoiced-consonant
d <- [[dD] comma* !h !d !unvoiced-consonant
g <- [[gG] comma* !h !g !unvoiced-consonant
v <- [[vV] comma* !h !v !unvoiced-consonant
j <- [[jJ] comma* !h !sibilant !unvoiced-consonant
z <- [[zZ] comma* !h !sibilant !unvoiced-consonant
s <- [[sS] comma* !h !sibilant !voiced-consonant
c <- [[cC] comma* !h !sibilant !voiced-consonant !x
x <- [[xX] comma* !h !x !voiced-consonant !c !k
k <- [[kK] comma* !h !k !voiced-consonant !x
f <- [[fF] comma* !h !f !voiced-consonant
p <- [[pP] comma* !h !p !voiced-consonant
t <- [[tT] comma* !h !t !voiced-consonant

h <- [['h] comma* &vowel

;-------------------------------------------------------------------

comma <- [[,]
space <- [[ .]

non-lojban-word <- (!space .)*

EOF <- !.

;-------------------------------------------------------------------
;-------------------------------------------------------------------