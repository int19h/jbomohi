	}
}

gliban.alias
foreach (%line, $split("\n", $file.read("/home/arran/Documents/languages/lojban/cmavo.txt")))
{
	if ($str.contains($str.mid(%line,20,61),$0) == 1)
	{
		echo %line
	}
}
foreach (%line, $split("\n", $file.read("/home/arran/Documents/languages/lojban/gismu.txt")))
