__{jvsv cabdeicerni}__


 cerni cer          morning
                    x1 is a morning ~np~[dawn until after typical
                    start-of-work for locale]~/np~ of day x2 at location x3

                    ~np~[this morning (= __cabdeicerni__); tomorrow morning
                    (= bavlamcerni); yesterday morning (= prulamcerni,
                    prulamdeicerni)]~/np~(cf. vanci, murse, tcika)

__{jvsv cabjeftu}__


 jeftu jef          week
                    x1 is x2 weeks in duration (default is 1 week)
                    by standard x3

                    ~np~[re. x3, a week may be more or less than seven days,
                    classically being tied to the time between trips
                    to the marketplace; this week (= __cabjeftu__); next
                    week (= bavlamjeftu); last week (= prulamjeftu)]~/np~;
                    (cf. detri, djedi, masti, nanca)

__{jvsv cabvanci}__


 vanci vac          evening
                    x1 is an evening ~np~[from end-of-work until sleep
                    typical for locale]~/np~ of day x2 at location x3

                    ~np~[this evening (= __cabvanci__); tomorrow evening (=
                    bavlamvanci); yesterday evening (= prulamvanci)]~/np~;
                    (cf. cerni, murse, tcika)

__{jvsv cabycte}__


 nicte     cte      night
                    x1 is a nighttime of day x2 at location x3;
                    (adjective:) x1 is at night/nocturnal

                    ~np~[tonight (= __cabycte__); tomorrow night (= bavlamcte,
                    even when tonight is still in the future); last night
                    (= prulamcte)]~/np~; (cf. donri, djedi, tcika)

__{jvsv cackle}__


 cmoni     cmo co'i moan
                    x1 utters moan/groan/howl/scream ~np~[non-linguistic
                    utterance]~/np~ x2 expressing x3 (property)

                    ~np~[also shriek, most animal sounds, e.g. bark, __cackle__,
                    meow, neigh, moo, honk, baa, crow]~/np~ (cf. krixa, bacru,
                    cusku, cortu)

__{jvsv cacryra'o}__


 radno         ra'o radian
                    x1 is x2 radian(s) ~np~[metric unit]~/np~ in angular measure
                    (default is 1) by standard x3

                    ~np~[measured in degrees (julra'o); right ascension
                    NOT HANDLED: ~np~[((jbovlaste import: astronomical measurement]~/np~ (= __cacryra'o__) lang en)) (cf. jganu,
                    kilto, centi, decti, dekto, femti, gigdo, gocti,
                    gotro, gutci, litce, megdo, mikri, milti, minli,
                    nanvi, petso, picti, terto, xatsi, xecto, xexso,
                    zepti, zetro)

__{jvsv cacyzei}__


 zekri zer     zei  crime
                    x1 (event/state) is a crime/~np~[taboo/offense/sin]~/np~
                    to people/culture/judges/jury x2      8d  24    ~np~[

                    kluzei, __cacyzei__); sin (= madzei, jdamadzei); heresy
                    (= jdazei)]~/np~; (cf. flalu, sfasa, zungi, palci, lijda,
                    pajni, javni, tcaci, marde, pulji, tinbe)

__{jvsv caifle}__


 flecu     fle      flow                 ' flush '
                    x1 is a current/flow/river of/in x2 flowing in
                    direction to/towards x3 from direction/source x4

                    ~np~[x1 is a stream of x2; x2 is a fluid [((jbovlaste import: gas or liquid]~/np~
                    (= selfle for reordered places); x1 flushes toward
                    x3; flush (= __caifle__, sukfle) lang en)); (cf. rirxe, senta
                    where no directionality is implied, rinci, xampo,
                    dikca, sakci, gapci, litki, ciblu)

__{jvsv cajbe'e}__


 bende bed     be'e crew                 ' band '
                    x1 is a crew/team/gang/squad/band of persons x2
                    directed/led by x3 organized for purpose x4

                    (x1 is a mass; x2 is a set completely specified);
                    ~np~[also orchestra (= zgibe'e, balzgibe'e), outfit; x3
                    conductor; business, not necessarily incorporated (=
                    __cajbe'e__, venbe'e)]~/np~; (cf. gunma, girzu, dansu, jatna,
                    jitro, kagni, kamni, minde, ralju, cecmu, gidva)

__{jvsv cakyjme}__


 jemna     jme      gem
                    x1 is a gem/polished stone/pearl of type x2 from
                    gemstone/material/source x3

                    ~np~[also jewel (= jmeja'i); gemstone (= x2, x3, or
                    jmero'i, jmekunra); pearl (= sel__cakyjme__ - a gem
                    found inside a shell, ter__cakyjme__ - a gem made of
                    shell material, boijme - any ball-shaped gem),
                    mother-of-pearl (= __cakyjme__)]~/np~; (cf. kunra, rokci,
                    jadni, dirba, kargu, krili, pulji)

__{jvsv camgu'i}__


 carmi cam     cai  intense
                    x1 is intense/bright/saturated/brilliant in property
                    (ka) x2 as received/measured by observer x3

                    ~np~[also lustrous, gleaming, sparkling, shining (all
                    probably better metaphorically combined with gusni:
                    gusycai or __camgu'i__); in colors, refers principally
                    to increased saturation (with opposite kandi)]~/np~;
                    (cf. denmi, gusni, kandi, ruble, skari, tilju,
                    tsali, mutce, blabi, blanu, bunre, cicna, crino,
                    grusi, narju, nukni, pelxu, xekri, xunre, zirpu)

