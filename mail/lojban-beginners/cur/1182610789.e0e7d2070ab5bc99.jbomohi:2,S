b - b
c - sx
d - d
e - e
f - f
g - g
i - i
i - j (in diphthongs)
j - jx
k - k
l - l
m - m
n - n
o - o
p - p
r - r
s - s
t - t
u - u
u - ux (in diphthongs)
v - v
x - hx
y - not available
z - z
' - h

