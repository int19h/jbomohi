<?php
$gismu = fopen("/usr/share/lojban/gismu.txt", "r");

fgets($gismu);

$gismumap = array();

while (!feof ($gismu)) {
 $line = fgets($gismu, 8192);
 $g = substr($line, 1, 5);
 $g = trim($g);
 $gloss = substr($line, 20, 20);
 $gismumap[$g] = $gloss;
}
fclose($gismu);

$cmavo = fopen("/usr/share/lojban/cmavo.txt", "r");

fgets($cmavo);

$cmavomap = array();

while (!feof ($cmavo)) {
 $line = fgets($cmavo, 8192);
 $g = substr($line, 1, 10);
 $g = trim($g);
 $gloss = substr($line, 20, 42);
 $cmavomap[$g] = $gloss;
}
fclose($cmavo);



/*print_r($gismumap);*/

$file = fopen ("http://www.digitalkingdom.org/~rlpowell/hobbies/lojban/palm/la%20nicte%20cadzu/nic-1.1-1.html", "r");
if (!$file) {
   echo "<p>Unable to open remote file.\n";
   exit;
}

while (!feof ($file)) {
   $line = fgets ($file, 8192);
   $input = strtok($line, " ");
   while($input !== false) {
	if($gismumap[$input] == null) {
         if($cmavomap[$input] == null) {
          echo $input;
         } else {
            echo "<a href=\"javascript: void(0)\" title=\"";
            echo $cmavomap[$input];
            echo "\">";
            echo $input;
            echo "</a>";
	  }
	}
        else {

	echo "<a href=\"javascript: void(0)\" title=\"";
        echo $gismumap[$input];
        echo "\">";
        echo $input;
        echo "</a>";
        }
	$input = strtok(" ");
	echo " ";
   }

}

echo "done";
fclose($file);
?> 


