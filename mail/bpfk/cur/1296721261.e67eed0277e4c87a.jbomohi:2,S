     <para> <indexterm type=3D"general-imported"><primary>sentences</primar=
y><secondary>tenseless</secondary><tertiary>quick-tour version</tertiary></=
indexterm> The Lojban sentence</para>
     <example role=3D"interlinear-gloss-example" xml:id=3D"example-random-i=
d-k1xz">
       <title>
         <anchor xml:id=3D"c2e17d3"/>
       </title>
       <interlinear-gloss>
-        <jbophrase role=3D"sumti">la djan.</jbophrase>  [cu]=20
-        <jbophrase role=3D"selbri">klama</jbophrase>
-        <jbophrase role=3D"sumti">le zarci</jbophrase>
-        John      goes/went/will-go  to-the store
+        <jbo>
+          <sumti>la djan.</sumti>=20
+          <elidable>cu</elidable>
+          <selbri>klama</selbri>
+          <sumti>le zarci</sumti>
+        </jbo>
+        <gloss>
