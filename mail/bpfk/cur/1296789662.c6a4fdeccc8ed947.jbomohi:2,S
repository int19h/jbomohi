     </programlisting>
     <bridgehead>
-      <anchor xml:id=3D"VAU"/> selma'o VAU (<xref linkend=3D"chapter-conne=
ctives-section-compound-bridi"/>)
+      <anchor xml:id=3D"VAU"/> selma'o VAU (<xref linkend=3D"section-compo=
und-bridi"/>)
     </bridgehead>
