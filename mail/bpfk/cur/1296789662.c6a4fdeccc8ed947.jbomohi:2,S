     <bridgehead>
       <anchor xml:id=3D"VEI"/> selma'o VEI (=20
-      <xref linkend=3D"chapter-mekso-section-simple-infix"/>)
+      <xref linkend=3D"section-simple-infix"/>)
     </bridgehead>
