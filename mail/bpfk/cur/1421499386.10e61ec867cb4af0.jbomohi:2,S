.m=C3=A1ius. (ja .m=C3=A1jus.)
> >> .j=C3=BAni'us. .j=C3=BAli'us. .aug=C3=BAstus. .sept=C3=A9mber. .okt=C3=
=B3ber. .nov=C3=A9mber.
> >> .dec=C3=A9mber.
