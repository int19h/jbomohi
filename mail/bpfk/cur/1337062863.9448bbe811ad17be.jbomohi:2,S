+                  <td>3</td>
+                </tr>
+                <tr>
+                  <td>CCVC</td>
+                  <td>(<rafsi>-zbas-</rafsi>)</td>
+                  <td>4</td>
+                </tr>
+                <tr>
+                  <td>CVC</td>
