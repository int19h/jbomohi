-  <section xml:id=3D"section-FA">
-    <title>Tagging places: FA</title>
-    <para>The following cmavo are discussed in this section:</para>
-    <cmavo-list>
-      <cmavo-entry>
-        <cmavo>fa</cmavo>
-        <selmaho>FA</selmaho>
