+    <para>=20
+<indexterm type=3D"general"><primary>sexual teacher</primary><secondary>ma=
le</secondary><tertiary>example</tertiary></indexterm> =20
+
+<indexterm type=3D"general"><primary>male sexual teacher</primary><seconda=
ry>example</secondary></indexterm>
