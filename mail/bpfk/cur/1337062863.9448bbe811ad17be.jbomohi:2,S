+<chapter xml:id=3D"chapter-relative-clauses">
+  <title>Relative Clauses, Which Make sumti Even More Complicated</title>
+  <mediaobject xml:id=3D"chapter-relative-clauses-picture">
+    <alt>The picture for chapter 8</alt>
