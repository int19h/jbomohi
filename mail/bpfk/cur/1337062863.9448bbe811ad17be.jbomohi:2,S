+
+  <section xml:id=3D"section-ke-grouping">
+    <title>Complex tanru with=20
+    <valsi>ke</valsi> and=20
+    <valsi>ke'e</valsi></title>
+   =20
+    <para>The following cmavo are discussed in this section:</para>
+    <cmavo-list>
+      <cmavo-entry>
+        <cmavo>ke</cmavo>
+        <selmaho>KE</selmaho>
+        <description>start grouping</description>
+      </cmavo-entry>
+      <cmavo-entry>
+        <cmavo>ke'e</cmavo>
