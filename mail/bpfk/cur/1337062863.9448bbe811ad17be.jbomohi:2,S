-    <para><indexterm type=3D"general-imported"><primary>unqualified sumti<=
/primary><secondary>contrasted with qualified sumti</secondary></indexterm>=
  <indexterm type=3D"general-imported"><primary>qualified sumti</primary><s=
econdary>contrasted with unqualified sumti</secondary></indexterm></para>
-    <example role=3D"interlinear-gloss-example" xml:id=3D"example-random-i=
d-6W3v">
-      <title>   =20
