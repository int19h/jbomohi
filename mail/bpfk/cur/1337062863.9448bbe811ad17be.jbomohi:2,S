xample">
+      <title>
+       =20
+
+<indexterm type=3D"example"><primary>Preem Palver</primary><secondary>exam=
ple</secondary></indexterm>
+
+=20
+        <anchor xml:id=3D"c5e9d6"/>
+      </title>
+      <interlinear-gloss>
