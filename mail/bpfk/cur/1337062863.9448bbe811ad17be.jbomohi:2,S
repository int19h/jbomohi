+          <diphthong>e,i</diphthong>,=20
+          <diphthong>o,i</diphthong> and=20
+          <diphthong>a,o</diphthong>.
+        </para>
+      </listitem>
+      <listitem>
+        <para>
+          <morphology>i'a</morphology> through=20
+          <morphology>i'u</morphology> and=20
+          <morphology>u'a</morphology> through=20
