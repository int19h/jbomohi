-        <anchor xml:id=3D"c5e13d4"/>
-      </title>
-      <interlinear-gloss>
-        <jbo>mi na na klama le zarci</jbo>
-        <gloss>It is false that it is false that I go to the market.</glos=
s>
-        <natlang>I go to the market.</natlang>
-      </interlinear-gloss>
