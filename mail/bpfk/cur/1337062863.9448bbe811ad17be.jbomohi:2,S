+          <diphthong>ei</diphthong>,=20
+          <diphthong>oi</diphthong>,=20
+          <diphthong>au</diphthong> become=20
+          <diphthong>ai</diphthong>,=20
+          <diphthong>ei</diphthong>,=20
+          <diphthong>oi</diphthong>,=20
+          <diphthong>ao</diphthong>.
+        </para>
+      </listitem>
+      <listitem>
+        <para>
+          <diphthong>ia</diphthong> through=20
+          <diphthong>iu</diphthong> and=20
+          <diphthong>ua</diphthong> through=20
+          <diphthong>uu</diphthong> remain unchanged.
+        </para>
+      </listitem>
+      <listitem>
+        <para>
+          <morphology>a'i</morphology>,=20
+         =20
+          <morphology>e'i</morphology>,=20
+          <morphology>o'i</morphology> and=20
+         =20
+          <morphology>a'o</morphology> become=20
+         =20
