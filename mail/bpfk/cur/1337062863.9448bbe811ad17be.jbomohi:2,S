+        <natlang>This is an amusement room.</natlang>
+      </interlinear-gloss>
+    </example>
+    <para> <indexterm type=3D"general-imported"><primary>abstraction bridi=
</primary><secondary>contrasted with component non-abstraction bridi in mea=
ning</secondary></indexterm>=20
+    <xref linkend=3D"example-random-id-5szz"/> is quite distinct in meanin=
g from:</para>
+    <example role=3D"interlinear-gloss-example" xml:id=3D"example-random-i=
d-yNSI">
+      <title>
+        <anchor xml:id=3D"c5e9d9"/>
+      </title>
+      <interlinear-gloss>
+        <jbo>ti zdile kumfa</jbo>
+        <gloss>This is-an-amuser room.</gloss>
