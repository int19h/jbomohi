-<anchor xml:id=3D"cll_chapter2-section15-example7" />15.7) =20
+<anchor xml:id=3D"cll_chapter2-section15-example7" /> 15.7) =20
 <jbophrase role=3D"sumti">mi</jbophrase> [cu]=20
