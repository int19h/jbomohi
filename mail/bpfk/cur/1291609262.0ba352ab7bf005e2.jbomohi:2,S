+   </tbody>
+  </tgroup>
+ </informaltable>
+</xsl:template>
+
+<xsl:template name=3D"generate-colspecs">
+ <xsl:param name=3D"count" select=3D"0"/>
+ <xsl:param name=3D"number" select=3D"1"/>
+ <xsl:choose>
+  <xsl:when test=3D"$count &lt; $number"/>
+  <xsl:otherwise>
+   <colspec>
+    <xsl:attribute name=3D"colnum">
+     <xsl:value-of select=3D"$number"/>
+    </xsl:attribute>
