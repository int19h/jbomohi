tion()"/>
+</xsl:template>
+
+<xsl:template name=3D"count_columns">
+ <xsl:param name=3D"table" select=3D"."/>
+ <xsl:param name=3D"row" select=3D"$table//html:tr[1]"/>
+ <xsl:param name=3D"max" select=3D"0"/>
+ <xsl:choose>=20
+  <xsl:when test=3D"local-name($table) !=3D 'table'">
+   <xsl:message>Attempting to count columns on a non-table element</xsl:me=
ssage>
+  </xsl:when>
+  <xsl:when test=3D"local-name($row) !=3D 'tr'">
+   <xsl:message>Row parameter is not a valid row</xsl:message>
+  </xsl:when>
+  <xsl:otherwise>
+   <!-- Count cells in the current row -->
+   <xsl:variable name=3D"current_count">
+    <xsl:call-template name=3D"count_cells">
+     <xsl:with-param name=3D"cell" select=3D"$row/html:td[1]|$row/html:th[=
1]"/>
+    </xsl:call-template>
+   </xsl:variable>
+   <!-- Check for the maximum value of $current_count and $max -->
+   <xsl:variable name=3D"new_max">
+    <xsl:choose>
+     <xsl:when test=3D"$current_count &gt; $max">
+      <xsl:value-of select=3D"number($current_count)"/>
+     </xsl:when>
+     <xsl:otherwise>
+      <xsl:value-of select=3D"number($max)"/>
+     </xsl:otherwise>
+    </xsl:choose>
+   </xsl:variable>
+   <!-- If this is the last row, return $max, otherwise continue -->
+   <xsl:choose>
+    <xsl:when test=3D"count($row/following-sibling::html:tr) =3D 0">
+     <xsl:value-of select=3D"$new_max"/>
+    </xsl:when>
+    <xsl:otherwise>
+     <xsl:call-template name=3D"count_columns">
+      <xsl:with-param name=3D"table" select=3D"$table"/>
+      <xsl:with-param name=3D"row" select=3D"$row/following-sibling::html:=
tr"/>
+      <xsl:with-param name=3D"max" select=3D"$new_max"/>
+     </xsl:call-template>
+    </xsl:otherwise>
+   </xsl:choose>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+
+<xsl:template name=3D"count_cells">
+ <xsl:param name=3D"cell"/>
+ <xsl:param name=3D"count" select=3D"0"/>
+ <xsl:variable name=3D"new_count">
+  <xsl:choose>
+   <xsl:when test=3D"$cell/@colspan &gt; 1">
+    <xsl:value-of select=3D"number($cell/@colspan) + number($count)"/>
+   </xsl:when>
+   <xsl:otherwise>
+    <xsl:value-of select=3D"number('1') + number($count)"/>
+   </xsl:otherwise>
+  </xsl:choose>
+ </xsl:variable>
+ <xsl:choose>
+  <xsl:when test=3D"count($cell/following-sibling::*) &gt; 0">
+   <xsl:call-template name=3D"count_cells">
+    <xsl:with-param name=3D"cell"
+                    select=3D"$cell/following-sibling::*[1]"/>
+    <xsl:with-param name=3D"count" select=3D"$new_count"/>
+   </xsl:call-template>
+  </xsl:when>
+  <xsl:otherwise>
+   <xsl:value-of select=3D"$new_count"/>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+
+</xsl:stylesheet>
