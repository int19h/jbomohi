+    English =E2=80=9CBrown=E2=80=9D            braun.
+    English =E2=80=9CCharles=E2=80=9D          tcarlz.
+    French =E2=80=9CCharles=E2=80=9D           carl.
+    French =E2=80=9CDe Gaulle=E2=80=9D         dyGOL.
+    German =E2=80=9CHeinrich=E2=80=9D          xainrix.
+    Spanish =E2=80=9CJoaquin=E2=80=9D          xuaKIN.
+    Russian =E2=80=9CSvetlana=E2=80=9D         sfietlanys.
+    Russian =E2=80=9CKhrushchev=E2=80=9D       xrucTCOF.
+    Hindi =E2=80=9CKrishna=E2=80=9D            kricnas.
+    Polish =E2=80=9CLech Walesa=E2=80=9D       lex. va,uensas.
+    Spanish =E2=80=9CDon Quixote=E2=80=9D      don. kicotes.
+      or modern Spanish:       don. kixotes.
+      or Mexican dialect:      don. ki'otes.
+    Chinese =E2=80=9CMao Zedong=E2=80=9D       maudzydyn.
