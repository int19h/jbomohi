diff --git a/todocbook/glom.sh b/todocbook/glom.sh
new file mode 100755
index 0000000..618213b
--- /dev/null
+++ b/todocbook/glom.sh
@@ -0,0 +1,55 @@
+#!/bin/sh
+
+chapter=3D$(echo $1 | sed -e 's;/*$;;' -e 's;.*/;;')
+echo "chapter: $chapter"
+
+# Make the chapter header
+sed -n '1,/<\/h2>/p
+/<\/body>/,$p' $1/1/index.html | \
+  sed '/<div/,/<hr \/>/d' >/tmp/glom.out
+
+tidy -quiet -config fix.tidy /tmp/glom.out >/tmp/glom.out2
+
+xsltproc --path dtd/ --nonet --stringparam filename /tmp/glom.out2 \
+  --stringparam prefix cll html2docbook.xslt /tmp/glom.out2 \
+  > /tmp/glom.out3
+
+rm $chapter.xml
+touch $chapter.xml
+
+sed "s;<section xmlns:xlink=3D\"http://www.w3.org/1999/xlink\" xml:id=3D\"=
cll_/tmp/glom.out2\">;<chapter xml:id=3D\"cll_chapter$chapter\">;" /tmp/glo=
m.out3 | \
+sed '/<?xml version=3D"1.0"?>/d' | \
+sed 's;</section>;;' >>$chapter.xml
+echo >>$chapter.xml
+
+for suffix in $(find $1 -type f -name '*.html' | sed -e "s;^$1/*;;" | sort=
 -t/ -k1n)
+do
+  file=3D"$1$suffix"
+  echo $file
+  section=3D$(echo $file | sed -e "s;^$1/*;;" -e "s;/.*;;")
+  echo s: $section
+
+  tidy -quiet -config fix.tidy $file >/tmp/glom.out
+  perl munge.pl /tmp/glom.out $chapter $section >/tmp/glom.out2
+
+  # Debugging
+  # cp /tmp/glom.out2 $chapter-$section.munged
+
+  xsltproc --maxdepth 512 --path dtd/ --nonet --stringparam filename /tmp/=
glom.out2 \
+    --stringparam prefix cll html2docbook.xslt /tmp/glom.out2 \
+    > /tmp/glom.out3
+
+  sed "s;<section xmlns:xlink=3D\"http://www.w3.org/1999/xlink\" xml:id=3D=
\"cll_/tmp/glom.out2\">;<section xml:id=3D\"cll_chapter$chapter-section$sec=
tion\">;" /tmp/glom.out3 | \
+
+  # Fix up labels
+  sed 's;<anchor xml:id=3D"cll_yacc-\([^"]*\)"/>;<anchor xreflabel=3D"YACC=
 rule #\1" xml:id=3D"cll_yacc-\1"/>;g' | \
+  sed 's;<anchor xml:id=3D"cll_bnf-\([^"]*\)"/>;<anchor xreflabel=3D"BNF r=
ule #\1" xml:id=3D"cll_bnf-\1"/>;g' | \
+
+  sed '/<?xml version=3D"1.0"?>/d' >>$chapter.xml
+  echo >>$chapter.xml
+
+  rm /tmp/glom.out /tmp/glom.out2 /tmp/glom.out3
+done
+
+echo "
+</chapter>" >>$chapter.xml
diff --git a/todocbook/html2docbook.xslt b/todocbook/html2docbook.xslt
new file mode 100644
index 0000000..28e3f2a
--- /dev/null
+++ b/todocbook/html2docbook.xslt
@@ -0,0 +1,672 @@
+<?xml version=3D"1.0" encoding=3D"UTF-8"?><xsl:stylesheet version=3D"1.0"=
=20
+                xmlns:xsl=3D"http://www.w3.org/1999/XSL/Transform"=20
+                xmlns:fo=3D"http://www.w3.org/1999/XSL/Format"=20
+                xmlns:html=3D"http://www.w3.org/1999/xhtml"=20
+                xmlns:xlink=3D"http://www.w3.org/1999/xlink"
+                xmlns:saxon=3D"http://icl.com/saxon"
+                exclude-result-prefixes=3D"xsl fo html saxon">
+
+<xsl:output method=3D"xml" indent=3D"yes"/>
+<xsl:param name=3D"filename"></xsl:param>=20
+<xsl:param name=3D"prefix">wb</xsl:param>
+<xsl:param name=3D"graphics_location">file:///epicuser/AISolutions/graphic=
s/AIWorkbench/</xsl:param>
+
+<!-- Main block-level conversions -->
+<xsl:template match=3D"html:html">
+ <xsl:apply-templates select=3D"html:body"/>
+</xsl:template>
+
+<!-- This template converts each HTML file encountered into a DocBook=20
+     section.  For a title, it selects the first h1 element -->
+<xsl:template match=3D"html:body">
+ <section>
+  <xsl:if test=3D"$filename !=3D ''">
+   <xsl:attribute name=3D"xml:id">
+    <xsl:value-of select=3D"$prefix"/>
+    <xsl:text>_</xsl:text>
+    <xsl:value-of select=3D"translate($filename,' ()','__')"/>
+   </xsl:attribute>
+  </xsl:if>
+  <title>
+   <xsl:value-of select=3D".//html:h1[1]
+                         |.//html:h2[1]
+                         |.//html:h3[1]"/>
+  </title>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </section>
+</xsl:template>
+
+<!-- This template matches on all HTML header items and makes them into=20
+     bridgeheads. It attempts to assign an ID to each bridgehead by lookin=
g=20
+     for a named anchor as a child of the header or as the immediate prece=
ding
+     or following sibling -->
+<xsl:template match=3D"html:h1
+              |html:h2
+              |html:h3
+              |html:h4
+              |html:h5
+              |html:h6">
+ <bridgehead>
+  <xsl:choose>
+   <xsl:when test=3D"count(html:a/@name)">
+    <xsl:attribute name=3D"xml:id">
+     <xsl:value-of select=3D"html:a/@name"/>
+    </xsl:attribute>
+   </xsl:when>
+   <xsl:when test=3D"preceding-sibling::* =3D preceding-sibling::html:a[@n=
ame !=3D '']">
+    <xsl:attribute name=3D"xml:id">
+    <xsl:value-of select=3D"concat($prefix,preceding-sibling::html:a[1]/@n=
ame)"/>
+    </xsl:attribute>
+   </xsl:when>
+   <xsl:when test=3D"following-sibling::* =3D following-sibling::html:a[@n=
ame !=3D '']">
+    <xsl:attribute name=3D"xml:id">
+    <xsl:value-of select=3D"concat($prefix,following-sibling::html:a[1]/@n=
ame)"/>
+    </xsl:attribute>
+   </xsl:when>
+  </xsl:choose>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </bridgehead>
+</xsl:template>
+       =20
+<!-- These templates perform one-to-one conversions of HTML elements into
+     DocBook elements -->
+<xsl:template match=3D"html:p">
+<!-- if the paragraph has no text (perhaps only a child <img>), don't=20
+     make it a para -->
+ <xsl:choose>
+  <xsl:when test=3D"normalize-space(.) =3D ''">
+   <xsl:apply-templates select=3D"node()|comment()|text()|processing-instr=
uction()"/>
+  </xsl:when>
+  <xsl:otherwise>
+ <para>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </para>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+<xsl:template match=3D"html:pre">
+ <programlisting>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </programlisting>
+</xsl:template>
+<xsl:template match=3D"html:code">
+ <programlisting>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </programlisting>
+</xsl:template>
+<xsl:template match=3D"html:cite">
+  <citation>
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </citation>
+</xsl:template>
+<xsl:template match=3D"html:sup">
+  <superscript>
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </superscript>
+</xsl:template>
+<xsl:template match=3D"html:em">
+  <emphasis>
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </emphasis>
+</xsl:template>
+<xsl:template match=3D"html:sub">
+  <subscript>
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </subscript>
+</xsl:template>
+<xsl:template match=3D"comment()">
+  <xsl:copy/>
+</xsl:template>
+
+<!-- LOCAL ADDITIONS -->
+<xsl:template match=3D"html:span[@class=3D'tru']">
+  <phrase role=3D"logical-vowel">
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </phrase>
+</xsl:template>
+<xsl:template match=3D"html:span[@class=3D'c3']">
+  <phrase role=3D"IPA">
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </phrase>
+</xsl:template>
+<xsl:template match=3D"html:td[@class=3D'c3']">
+  <entry>
+    <phrase role=3D"IPA">
+      <xsl:apply-templates select=3D"node()|comment()|text()|processing-in=
struction()"/>
+    </phrase>
+  </entry>
+</xsl:template>
+<xsl:template match=3D"html:span[@class=3D'sumti']">
+  <foreignphrase xml:lang=3D"jbo" role=3D"sumti">
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </foreignphrase>
+</xsl:template>
+<xsl:template match=3D"html:span[@class=3D'selbri']">
+  <foreignphrase xml:lang=3D"jbo" role=3D"selbri">
+    <xsl:apply-templates select=3D"node()|comment()|text()|processing-inst=
ruction()"/>
+  </foreignphrase>
+</xsl:template>
+
+<!-- Hyperlinks -->
+<xsl:template match=3D"html:a[contains(@href,'http://')]" priority=3D"1.5"=
>
+ <link>
+  <xsl:attribute name=3D"xlink:href">
+   <xsl:value-of select=3D"normalize-space(@href)"/>
+  </xsl:attribute>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </link>
+</xsl:template>
+<xsl:template match=3D"html:a[contains(@href,'ftp://')]" priority=3D"1.5">
+ <link>
+  <xsl:attribute name=3D"xlink:href">
+   <xsl:value-of select=3D"normalize-space(@href)"/>
+  </xsl:attribute>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </link>
+</xsl:template>
+
+<xsl:template match=3D"html:a[contains(@href,'#')]" priority=3D"1.0">
+ <xref>
+  <xsl:attribute name=3D"linkend">
+   <xsl:call-template name=3D"make_id">
+    <xsl:with-param name=3D"string" select=3D"substring-after(@href,'#')"/=
>
+   </xsl:call-template>
+  </xsl:attribute>
+ </xref>
+</xsl:template>
+
+<xsl:template match=3D"html:a[contains(@href,'mailto:')]" priority=3D"1.0"=
>
+ <link>
+  <xsl:attribute name=3D"xlink:href">
+   <xsl:value-of select=3D"normalize-space(@href)"/>
+  </xsl:attribute>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </link>
+</xsl:template>
+
+<!-- These two templates are exactly the same, except one uses a's
+     id and the other a's name; please change both if you change
+     either.
+
+     BEGIN two mostly-identical templates=20
+     -->
+<xsl:template match=3D"html:a[@id !=3D '']" priority=3D"0.6">
+ <anchor>
+  <xsl:attribute name=3D"xml:id">
+   <xsl:call-template name=3D"make_id">
+    <xsl:with-param name=3D"string" select=3D"@id"/>
+   </xsl:call-template>
+  </xsl:attribute>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </anchor>
+</xsl:template>
+
+<xsl:template match=3D"html:a[@name !=3D '']" priority=3D"0.6">
+ <anchor>
+  <xsl:attribute name=3D"xml:id">
+   <xsl:call-template name=3D"make_id">
+    <xsl:with-param name=3D"string" select=3D"@name"/>
+   </xsl:call-template>
+  </xsl:attribute>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </anchor>
+</xsl:template>
+
+<!-- END two mostly-identical templates -->
+
+<!-- Match picture links -->
+<xsl:template match=3D"html:a[contains(@href,'.gif') or contains(@href,'.s=
vg') or contains(@href,'.png') or contains(@href,'.jpg')]" priority=3D"2.0"=
>
+  <mediaobject>
+    <alt>
+      <xsl:value-of select=3D"text()"/>
+    </alt>
+    <imageobject>
+      <imagedata>
+        <xsl:attribute name=3D"fileref">
+          <xsl:value-of select=3D"@href"/>
+        </xsl:attribute>
+      </imagedata>
+    </imageobject>
+  </mediaobject>
+</xsl:template>
+
+<xsl:template match=3D"html:a[@href !=3D '']" priority=3D"0.8">
+ <xref>
+  <xsl:attribute name=3D"linkend">
+   <xsl:value-of select=3D"$prefix"/>
+   <xsl:text>_</xsl:text>
+   <xsl:call-template name=3D"make_id">
+    <xsl:with-param name=3D"string" select=3D"@href"/>
+   </xsl:call-template>
+  </xsl:attribute>
+ </xref>
+</xsl:template>
+
+<!-- Need to come up with good template for converting filenames into ID's=
 -->
+<xsl:template name=3D"make_id">
+ <xsl:param name=3D"string" select=3D"''"/>
+ <xsl:variable name=3D"fixedname">
+  <xsl:call-template name=3D"get_filename">
+   <xsl:with-param name=3D"path" select=3D"translate($string,' \()','_/_')=
"/>
+  </xsl:call-template>
+ </xsl:variable>
+ <xsl:choose>
+  <xsl:when test=3D"contains($fixedname,'.htm')">
+   <xsl:value-of select=3D"substring-before($fixedname,'.htm')"/>
+  </xsl:when>
+  <xsl:otherwise>
+   <xsl:value-of select=3D"$fixedname"/>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+
+<xsl:template name=3D"string.subst">
+ <xsl:param name=3D"string" select=3D"''"/>
+ <xsl:param name=3D"substitute" select=3D"''"/>
+ <xsl:param name=3D"with" select=3D"''"/>
+ <xsl:choose>
+  <xsl:when test=3D"contains($string,$substitute)">
+   <xsl:variable name=3D"pre" select=3D"substring-before($string,$substitu=
te)"/>
+   <xsl:variable name=3D"post" select=3D"substring-after($string,$substitu=
te)"/>
+   <xsl:call-template name=3D"string.subst">
+    <xsl:with-param name=3D"string" select=3D"concat($pre,$with,$post)"/>
+    <xsl:with-param name=3D"substitute" select=3D"$substitute"/>
+    <xsl:with-param name=3D"with" select=3D"$with"/>
+   </xsl:call-template>
+  </xsl:when>
+  <xsl:otherwise>
+   <xsl:value-of select=3D"$string"/>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+
+<!-- Images -->
+<!-- Images and image maps -->
+<xsl:template match=3D"html:img">
+ <xsl:variable name=3D"tag_name">
+  <xsl:choose>
+   <xsl:when test=3D"boolean(parent::html:p) and=20
+        boolean(normalize-space(parent::html:p/text()))">
+    <xsl:text>inlinemediaobject</xsl:text>
+   </xsl:when>
+   <xsl:otherwise>mediaobject</xsl:otherwise>
+  </xsl:choose>
+ </xsl:variable>
+ <xsl:element name=3D"{$tag_name}">
+  <imageobject>
+   <xsl:call-template name=3D"process.image"/>
+  </imageobject>
+ </xsl:element>
+</xsl:template>
+
+<xsl:template name=3D"process.image">
+ <imagedata>
+<xsl:attribute name=3D"fileref">
+ <xsl:call-template name=3D"make_absolute">
+  <xsl:with-param name=3D"filename" select=3D"@src"/>
+ </xsl:call-template>
+</xsl:attribute>
+<xsl:if test=3D"@height !=3D ''">
+ <xsl:attribute name=3D"depth">
+  <xsl:value-of select=3D"@height"/>
+ </xsl:attribute>
+</xsl:if>
+<xsl:if test=3D"@width !=3D ''">
+ <xsl:attribute name=3D"width">
+  <xsl:value-of select=3D"@width"/>
+ </xsl:attribute>
+</xsl:if>
+ </imagedata>
+</xsl:template>
+
+<xsl:template name=3D"make_absolute">
+ <xsl:param name=3D"filename"/>
+ <xsl:variable name=3D"name_only">
+  <xsl:call-template name=3D"get_filename">
+   <xsl:with-param name=3D"path" select=3D"$filename"/>
+  </xsl:call-template>
+ </xsl:variable>
+ <xsl:value-of select=3D"$graphics_location"/><xsl:value-of select=3D"$nam=
e_only"/>
+</xsl:template>
+
+<xsl:template match=3D"html:ul[count(*) =3D 0]">
+ <xsl:message>Matched</xsl:message>
+ <blockquote>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </blockquote>
+</xsl:template>
+
+<xsl:template name=3D"get_filename">
+ <xsl:param name=3D"path"/>
+ <xsl:choose>
+  <xsl:when test=3D"contains($path,'/')">
+   <xsl:call-template name=3D"get_filename">
+    <xsl:with-param name=3D"path" select=3D"substring-after($path,'/')"/>
+   </xsl:call-template>
+  </xsl:when>
+  <xsl:otherwise>
+   <xsl:value-of select=3D"$path"/>
+  </xsl:otherwise>
+ </xsl:choose>
+</xsl:template>
+
+<!-- LIST ELEMENTS -->
+<xsl:template match=3D"html:ul">
+ <itemizedlist>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </itemizedlist>
+</xsl:template>
+
+<xsl:template match=3D"html:ol">
+ <orderedlist>
+  <xsl:apply-templates select=3D"node()|comment()|text()|processing-instru=
ction()"/>
+ </orderedlist>
+</xsl:template>
+       =20
+<!-- This template makes a DocBook variablelist out of an HTML definition =
