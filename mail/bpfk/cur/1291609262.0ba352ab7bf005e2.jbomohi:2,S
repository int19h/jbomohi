+<!-- Tables with thead and tbody -->
+<xsl:template match=3D"html:table[boolean(child::html:thead)]">
+<!-- <xsl:variable name=3D"column_count"
+               select=3D"saxon:max(.//html:tr,saxon:expression('count(html=
:td)'))"/> -->
+ <xsl:variable name=3D"column_count">
+  <xsl:call-template name=3D"count_columns">
