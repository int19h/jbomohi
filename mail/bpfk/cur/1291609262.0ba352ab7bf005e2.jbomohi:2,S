+#!/usr/bin/perl
+
+my $filename=3D$ARGV[0];
+
+my $chapter=3D$ARGV[1];
+
+my $section=3D$ARGV[2];
+
+if( ! $filename || ! $chapter || ! $section ) {
+  print "bad usage\n";
+  exit 1;
+}
+
+open my $fh, '<', $ARGV[0] or die "error opening $filename: $!";
+my $data =3D do { local $/ =3D undef; <$fh> };
+
+$data =3D~ s{<body>.*?<hr />}{<body>}sg;
+$data =3D~ s{<hr />.*?</body>}{</body>}sg;
+
+$data =3D~ s!<a id=3D"e([^"]*)">([^<]*)</a>!<a id=3D"c${chapter}e${section=
}d$1"></a><a id=3D"cll_chapter$chapter-section$section-example$1"></a>$2!sg=
;
+$data =3D~ s{<a href=3D"../([^/]*)/#e([^"]*)">}{<a href=3D"chapter$chapter=
-section$1-example$2">}sg;
+
+$data =3D~ s!<a id=3D"y([^"]*)">([^<]*)</a>!<a id=3D"y$1"></a><a id=3D"cll=
_yacc-$1"></a>$2!sg;
+$data =3D~ s{<a href=3D"(../[0-9]+/)?#y([^"]*)">}{<a href=3D"yacc-$2">}sg;
+
+$data =3D~ s!<a id=3D"b([^"]*)">([^<]*)</a>!<a id=3D"b$1"></a><a id=3D"cll=
_bnf-$1"></a>$2!sg;
+$data =3D~ s{<a href=3D"(../[0-9]+/)?#b([^"]*)">}{<a href=3D"bnf-$2">}sg;
+
+$data =3D~ s{<a href=3D"../([^/]+)/">}{<a href=3D"chapter$chapter-section$=
1">}sg;
+$data =3D~ s{<a href=3D"../([^/]+)/([^/]+)/?">}{<a href=3D"chapter$1-secti=
on$2">}sg;
+
+$data =3D~ s{<h4 id=3D"([^"]*)">}{<h4><a id=3D"$1"></a>}sg;
+
+$data =3D~ s{<h2>.*?</h2>}{}sg;
+$data =3D~ s{<a href=3D"../../([0-9]+)/1/">}{<a href=3D"chapter$1">}sg;
+
+print $data;
