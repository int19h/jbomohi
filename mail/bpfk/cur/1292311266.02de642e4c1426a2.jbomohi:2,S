       <title>
         <anchor xml:id=3D"c18e3d6" />
         <anchor xml:id=3D"cll_chapter18-section3-example6" />
         <anchor xml:id=3D"c18e3d7" />
         <anchor xml:id=3D"cll_chapter18-section3-example7" />
       </title>
       <interlinear-gloss>
         <jbo>ci mu ce'i</jbo>
+<!-- ^^   ce'i, 433 -->
+<indexterm><primary>ce'i</primary></indexterm>
         <gloss>three five percent</gloss>
+<!-- ^^   percent: as numerical punctuation, 433 -->
+<indexterm><primary>percent</primary></indexterm>
         <en>35%</en>
         <jbo>pa ki'o re ci vo ki'o mu xa ze</jbo>
+<!-- ^^   ki'o, 433 -->
