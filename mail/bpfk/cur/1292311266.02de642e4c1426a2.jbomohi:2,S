         <jbo>pi ci mu ra'e pa vo re bi mu ze</jbo>
+<!-- ^^   ra'e, 433 -->
+<indexterm><primary>ra'e</primary></indexterm>
         <gloss>point three five repeating one four two eight five seven</g=
loss>
