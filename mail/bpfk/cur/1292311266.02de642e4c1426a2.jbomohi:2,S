+<!-- ^^   mu'a, 319 -->
+<indexterm><primary>mu'a</primary></indexterm>
                                         examples
     zu'u          on the one hand                    on the other hand
+<!-- ^^   zu'u, 319 -->
+<indexterm><primary>zu'u</primary></indexterm>
     ke'u [krefu]  repeating                          continuing
+<!-- ^^   ke'u, 319; contrasted with va'i, 320 -->
