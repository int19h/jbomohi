#!/usr/bin/perl -nl
/^ (\w{1,2})([aeiou]\w{2,3}) / or next;
push @{$h{$2}}, "$1$2";
END{
    while ((undef, $v) = each %h){
        push @a, join " ", sort @$v if @$v > 1
    }
    print for (sort({length $b <=> length $a || $a cmp $b}
                @a));
}
