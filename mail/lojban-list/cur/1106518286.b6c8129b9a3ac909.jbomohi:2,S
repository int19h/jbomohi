<!-- 
     Created by Brian D. Eubanks
     Jan. 7, 2005
     Searches the online Lojban dictionary. 
     (Lojban is a constructed language. See http://www.lojban.org)
     Searches Any -> Lojban, and Lojban -> Any. 
 -->

<search
 version="7.1"
 name="lojban"
 description="Lojban Dictionary" 
 action="http://www.lojban.org/cgi-bin/dict.pl"
 searchForm="http://www.lojban.org/cgi-bin/dict.pl"
 method="GET" >

<input name="sourceid" value="Mozilla-search">
<input name="Form" value="dict.pl1">
<input name="Strategy" value="*">
<input name="Database" value="*">
<input name="Query" user="">

<interpret 
 resultListStart=" found"
 resultListEnd="<hr>"
 resultItemStart="</a>:"
 resultItemEnd="</pre>"
>

</search>

<browser
 update="http://mycroft.mozdev.org/plugins/lojban.src" 
 updateIcon="http://mycroft.mozdev.org/plugins/lojban.png" 
 updateCheckDays="3" 
>
