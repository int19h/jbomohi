"""you can asume this file is under GPLv3"""

def fuhivla (s):
	result =3D 'gugde'
	for i in range(len(s)):
		if (s[i] in ('A','E','I','O','U')):
			result =3D result + '\'' + s[i].lower()
		elif s[i] =3D=3D 'H':
			result =3D result + 'xe'
		elif s[i] =3D=3D 'Q':
			result =3D result + 'ke'
		elif s[i] =3D=3D 'W':
			result =3D result + 've'
		elif s[i] =3D=3D 'Y':
			result =3D result + 'je'
		else:
			result =3D result + s[i].lower() + 'u'
	return result

f =3D open('iso-countries.txt', 'r')
list =3D f.readlines()
listv, listr =3D [],[];

for i in range(len(list)):
	line =3D list[i]
	pos =3D line.find(';')
	'''this list has only vectors with the pattern ('name of the country','I=
SO code')'''
	listv =3D listv + [(line[:pos].title(),line[pos+1:-1])]
	'''this is the real deal'''
	listr =3D listr + [(line[pos+1:-1],fuhivla(line[pos+1:-1]))]
for i in range(len(listr)):
	print listr[i][0] + ' -> ' + listr[i][1] + '\n'

