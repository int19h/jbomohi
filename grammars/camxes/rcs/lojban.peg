; This is a Parsing Expression Grammar for Lojban.
; See http://www.pdos.lcs.mit.edu/~baford/packrat/
; 
; All rules have the form:
; 
; 	name <- peg-expression
; 
; which means that the grammatical construct "name" is parsed using
; "peg-expression".  
; 
; 1)  Names in lower case are grammatical constructs.
; 2)  Names in UPPER CASE are selma'o (lexeme) names, and are terminals.
; 3)  Concatenation is expressed by juxtaposition with no operator symbol.
; 4)  / represents *ORDERED* alternation (choice).  If the first
;     option succeeds, the others will never be checked.
; 5)  ? indicates that the element to the left is optional.
; 6)  * represents optional repetition of the construct to the left.
; 7)  + represents one-or-more repetition of the construct to the left.
; 8)  () serves to indicate the grouping of the other operators.
;
; Longest match wins.

; --- GRAMMAR ---

; This mess here is to allow the following preference relation:
; 1. no joik-jek, text-1
; 2. joik-jek, text-1 optional
; 3. neither
; 4. The above repeated with an optional introductory 'sa' clause; neither + intro-sa-clause is last
text <- (text-part-1 NAI* text-part-2? text-1 (FAhO dot-star)?) EOF / (text-part-1 NAI* text-part-2? joik-jek text-1? (FAhO dot-star)?) EOF / (text-part-1 NAI* text-part-2? (FAhO dot-star)?) EOF / (text-part-1-intro-sa-clause NAI* text-part-2? text-1 (FAhO dot-star)?) EOF / (text-part-1-intro-sa-clause NAI* text-part-2? joik-jek text-1? (FAhO dot-star)?) EOF / (text-part-1-intro-sa-clause NAI* text-part-2? (FAhO dot-star)?) EOF / (text-part-1 NAI* text-part-2? text-1 (FAhO dot-star)?) / (text-part-1 NAI* text-part-2? joik-jek text-1? (FAhO dot-star)?) / (text-part-1 NAI* text-part-2? (FAhO dot-star)?) / (text-part-1-intro-sa-clause NAI* text-part-2? text-1 (FAhO dot-star)?) / (text-part-1-intro-sa-clause NAI* text-part-2? joik-jek text-1? (FAhO dot-star)?) / (text-part-1-intro-sa-clause NAI* text-part-2? (FAhO dot-star)?)

text-part-1 <- spaces? su-clause* spaces? si-clause SI*
text-part-1-intro-sa-clause <- spaces? su-clause* spaces? intro-sa-clause spaces? si-clause SI*
text-part-2 <- (CMENE !ZEI !BU)+ free* / (indicators free+ / indicators / free+)

SPACE intro-sa-clause <- SA+ / any-word-SA-handling intro-sa-clause

; Please note that the "text-1" item in the text-1 production does
; *not* match the BNF. This is due to a bug in the BNF.  The change
; here was made to match grammar.300
text-1 <- I (jek / joik)? (stag? BO)? free* text-1? / NIhO+ free* su-clause* spaces? paragraphs? / paragraphs

paragraphs <- paragraph (NIhO+ free* su-clause* spaces? paragraphs)?

paragraph <- (statement / fragment) (I !jek !joik !joik-jek free* (statement / fragment)?)*

statement <- statement-1 / prenex statement

statement-1 <- statement-2 (I joik-jek statement-2)* / statement-2 (I joik-jek statement-2?)*

statement-2 <- statement-3 (I (jek / joik)? stag? BO free* statement-2)? / statement-3 (I (jek / joik)? stag? BO free*)?

statement-3 <- sentence / tag? TUhE free* text-1 (TUhU free*)?

fragment <- prenex / terms (VAU free*)? / ek free* / gihek free* / quantifier / NA !JA free* / relative-clauses / links / linkargs

prenex <- terms ZOhU free*

sentence <- (terms (CU free*)?)? bridi-tail / bridi-tail

subsentence <- sentence / prenex subsentence

bridi-tail <- bridi-tail-1 (gihek stag? KE free* bridi-tail (KEhE free*)? tail-terms)?

bridi-tail-1 <- bridi-tail-2 (gihek !(stag? BO) !(stag? KE) free* bridi-tail-2 tail-terms)*

bridi-tail-2 <- bridi-tail-3 (gihek stag? BO free* bridi-tail-2 tail-terms)?

bridi-tail-3 <- selbri tail-terms / gek-sentence

gek-sentence <- gek subsentence gik subsentence tail-terms / tag? KE free* gek-sentence (KEhE free*)? / NA free* gek-sentence

tail-terms <- terms? (VAU free*)?

terms <- terms-1+

terms-1 <- terms-2 (PEhE free* joik-jek terms-2)*

terms-2 <- term (CEhE free* term)*

term <- sumti / ( !gek (tag / FA free*) (sumti / (KU free*)?) ) / termset / NA KU free*

termset <- NUhI free* gek terms (NUhU free*)? gik terms (NUhU free*)? / NUhI free* terms (NUhU free*)?

sumti <- sumti-1 (VUhO free* relative-clauses)?

sumti-1 <- sumti-2 ((ek / joik) stag? KE free* sumti (KEhE free*)?)?

sumti-2 <- sumti-3 (joik-ek sumti-3)*

sumti-3 <- sumti-4 ((ek / joik) stag? BO free* sumti-3)?

sumti-4 <- sumti-5 / gek sumti gik sumti-4

sumti-5 <- quantifier? sumti-6 relative-clauses? / quantifier selbri (KU free*)? relative-clauses?

sumti-6 <- zo-clause indicators* free* / LOhU lohu-tail free* / lerfu-string-no-MOI BOI? free* / LU text (LIhU free*)? / (LAhE free* / NAhE BO free*) relative-clauses? sumti (LUhU free*)? / KOhA free* / LA free* relative-clauses? (CMENE !BU !ZEI)+ free* / (LA / LE) free* sumti-tail (KU free*)? / LI free* mex (LOhO free*)? / zoi-clause indicators* free*

lohu-tail <- lehu-si-clause lohu-tail / LEhU / any-word-no-SI-handling lohu-tail

lehu-si-clause <- LEhU SI / any-word-no-SI-handling SI / LEhU lehu-si-clause SI / any-word-no-SI-handling lehu-si-clause SI 

sumti-tail <- (sumti-6 relative-clauses?)? sumti-tail-1 / relative-clauses sumti-tail-1

sumti-tail-1 <- selbri relative-clauses? / quantifier selbri relative-clauses? / quantifier sumti

relative-clauses <- relative-clause (ZIhE free* relative-clause)*

relative-clause <- GOI free* term (GEhU free*)? / NOI free* subsentence (KUhO free*)?

selbri <- tag? selbri-1

selbri-1 <- selbri-2 / NA free* selbri

selbri-2 <- selbri-3 (CO free* selbri-2)?

selbri-3 <- selbri-4+

selbri-4 <- selbri-5 (joik-jek selbri-5 / joik stag? KE free* selbri-3 (KEhE free*)?)*

selbri-5 <- selbri-6 ((jek / joik) stag? BO free* selbri-5)?

selbri-6 <- tanru-unit (BO free* selbri-6)? / (NAhE free*)? guhek selbri gik selbri-6

tanru-unit <- tanru-unit-1 (CEI free* tanru-unit-1)*

tanru-unit-1 <- tanru-unit-2 linkargs?

tanru-unit-2 <- any-word spacing-no-absorb-opt (ZEI any-word spacing-no-absorb-opt)+ indicators* / BRIVLA free* / GOhA RAhO? free* / KE free* selbri-3 (KEhE free*)? / ME free* sumti (MEhU free*)? (MOI free*)? / (number / lerfu-string) MOI free* / NUhA free* mex-operator / SE free* tanru-unit-2 / JAI free* tag? tanru-unit-2 / NAhE free* tanru-unit-2 / NU NAI? free* (joik-jek NU NAI? free*)* subsentence (KEI free*)?

linkargs <- BE free* term links? (BEhO free*)?

links <- BEI free* term links?

quantifier <- number !MOI (BOI free*)? / VEI free* mex (VEhO free*)?

mex <- mex-1 (operator mex-1)* / FUhA free* rp-expression

mex-1 <- mex-2 (BIhE free* operator mex-1)?

mex-2 <- operand / (PEhO free*)? operator mex-2+ (KUhE free*)?

;li fu'a reboi ci pi'i voboi mu pi'i su'i reboi ci vu'u su'i du li rexa
;rp-expression <- rp-operand rp-operand operator
;rp-operand <- operand / rp-expression

rp-expression <- operand rp-expression-tail
rp-expression-tail <- rp-expression operator rp-expression-tail / ()

operator <- operator-1 (joik-jek operator-1 / joik stag? KE free* operator (KEhE free*)?)*

operator-1 <- operator-2 / guhek operator-1 gik operator-2 / operator-2 (jek / joik) stag? BO free* operator-1

operator-2 <- mex-operator / KE free* operator (KEhE free*)?

mex-operator <- SE free* mex-operator / NAhE free* mex-operator / MAhO free* mex (TEhU free*)? / NAhU free* selbri (TEhU free*)? / VUhU free*

operand <- operand-1 ((ek / joik) stag? KE free* operand (KEhE free*)?)?

operand-1 <- operand-2 (joik-ek operand-2)*

operand-2 <- operand-3 ((ek / joik) stag? BO free* operand-2)?

operand-3 <- quantifier / lerfu-string-no-MOI (BOI free*)? / NIhE free* selbri (TEhU free*)? / MOhE free* sumti (TEhU free*)? / JOhI free* mex-2+ (TEhU free*)? / gek operand gik operand-3 / (LAhE free* / NAhE BO free*) operand (LUhU free*)?

number <- PA (PA / lerfu-word)*

lerfu-string-no-MOI <- lerfu-word !MOI (PA !MOI / lerfu-word !MOI)*
lerfu-string <- lerfu-word (PA / lerfu-word)*

lerfu-word <- bu-clause / BY / LAU lerfu-word / TEI lerfu-string FOI

bu-clause <- Y BU+ / !(space-chars* bu-pre-check space-chars*) any-word-no-BU-handling BU+
bu-pre-check <- BU / ZEI / SI / SA / SU / BAhE / FAhO / ZO / ZOI / LOhU / LEhU

ek <- NA? SE? A NAI?

gihek <- NA? SE? GIhA NAI?

jek <- NA? SE? JA NAI?

joik <- SE? JOI NAI? / interval / GAhO interval GAhO

interval <- SE? BIhI NAI?

joik-ek <- joik free* / ek free*

joik-jek <- joik free* / jek free*

gek <- SE? GA NAI? free* / joik GI free* / stag gik

guhek <- SE? GUhA NAI? free*

gik <- GI NAI? free*

tag <- tense-modal (joik-jek tense-modal)*

stag <- simple-tense-modal ((jek / joik) simple-tense-modal)*

tense-modal <- simple-tense-modal free* / FIhO free* selbri (FEhU free*)?

simple-tense-modal <- NAhE? SE? BAI NAI? KI? / NAhE? ( ((time space? / space time?) CAhA) / (time space? / space time?) / CAhA ) KI? / KI / CUhE

time <- ZI time-offset* (ZEhA (PU NAI?)?)? interval-property* / ZI? time-offset+ (ZEhA (PU NAI?)?)? interval-property* / ZI? time-offset* ZEhA (PU NAI?)? interval-property* / ZI? time-offset* (ZEhA (PU NAI?)?)? interval-property+

time-offset <- PU NAI? ZI?

space <- VA space-offset* space-interval? (MOhI space-offset)? / VA? space-offset+ space-interval? (MOhI space-offset)? / VA? space-offset* space-interval (MOhI space-offset)? / VA? space-offset* space-interval? MOhI space-offset

space-offset <- FAhA NAI? VA?

space-interval <- (VEhA / VIhA / VEhA VIhA) (FAhA NAI?)? space-int-props / (VEhA / VIhA / VEhA VIhA) (FAhA NAI?)? / space-int-props

space-int-props <- (FEhE interval-property)+

interval-property <- number ROI NAI? / TAhE NAI? / ZAhO NAI?

free <- SEI free* (terms (CU free*)?)? selbri SEhU? / SOI free* sumti sumti? SEhU? / vocative relative-clauses? selbri relative-clauses? DOhU? / vocative relative-clauses? (CMENE !BU !ZEI)+ free* relative-clauses? DOhU? / vocative sumti? DOhU? / (number / lerfu-string) MAI / TO text TOI? / XI free* (number / lerfu-string) BOI? / XI free* VEI free* mex VEhO?

vocative <- (COI NAI?)+ DOI / (COI NAI?) (COI NAI?)* / DOI

indicators <- FUhE? indicator+

indicator <-  ((UI / CAI) NAI? / DAhO / FUhO) !BU


; ****
; zo
; ****
; ZO SI doesn't get a zo-si-clause because two SI in a row eat the ZO, so there is no way to use SI to get "zo si" unless the very first word after the ZO is a SI.
; The ZO SI SI case is to handle "zo si si broda si brode", which should be equal to "zo brode"
zo-clause <- ZO SI SI zo-si-clause? zo-clause / ZO zo-si-clause* SI / ZO zo-si-clause* !SI any-word spacing-no-absorb-opt

; ****
; ZOI
; ****
; Most of this stuff needs to be repeated to the si-clause section below if anything major is changed.

zoi-clause <- ZOI zoi-si-start? any-word-zoi &{ myAssign( new String(anyWordZoiSEP3.toString()) ) } zoi-si-middle? zoi-first-word? zoi-words

zoi-clause-no-SI-handling <- any-word-zoi &{ myAssign( new String(anyWordZoiSEP1.toString()) ) } zoi-first-word-no-SI-handling? zoi-words-no-SI-handling

zoi-first-word <- zoi-spacing-opt zoi-printable-word &{ !startString.equals(zoiPrintableWordSEP2) }

zoi-first-word-no-SI-handling <- zoi-spacing-opt zoi-printable-word &{ !startString.equals(zoiPrintableWordSEP2) }

zoi-words <- zoi-si-end zoi-printable-word &{ !startString.equals(zoiPrintableWordSEP2) } zoi-words / zoi-spacing zoi-printable-word &{ !startString.equals(zoiPrintableWordSEP2) } zoi-words / zoi-last-word

zoi-words-no-SI-handling <- zoi-spacing zoi-printable-word &{ !startString.equals(zoiPrintableWordSEP2) } zoi-words-no-SI-handling / zoi-last-word-no-SI-handling

zoi-last-word <- zoi-spacing any-word-zoi &{ startString.equals(anyWordZoiSEP2) } zoi-spacing-opt

; Exactly the same as the above; the point here is to stop the inital *backwards* ZOI check (from the expansion of the initial SI clause) from making bad decisions that we are then forced to keep.
zoi-last-word-no-SI-handling <- zoi-spacing any-word-zoi &{ startString.equals(anyWordZoiSEP2) } zoi-spacing-opt


NORATS zoi-printable-word <- (!space-chars-real .)+


; Indicator absorbtion; grammar.300 4d and 4e
spacing <- EOF / spaces si-clause indicators*
spacing-no-absorb <- EOF / spaces si-clause
spacing-no-absorb-opt <- EOF / spaces? si-clause
spacing-opt <- spacing / si-clause indicators*
spaces <- space-chars* (Y !BU)+ / space-chars+
;spaces-not-Y <- space-chars+

; For handling things of higher priority than SI (i.e. lo'u...le'u, zo)
spacing-no-SI-handling <- spaces
spacing-no-SI-handling-opt <- spaces?
si-spacing <- spaces

; For handling BU issues
spacing-no-BU-handling <- spaces
spacing-no-BU-handling-opt <- spaces?

; Handling of what can go after a cmavo
post-cmavo <- !tick-char !vowel !BU spacing-opt !ZEI !BU
pre-cmavo-check <- !BRIVLA-no-SI-handling !CMENE-no-SI-handling
post-cmavo-no-SA-handling <- !tick-char !vowel ( EOF / spaces / &SI / &SA )
post-cmavo-no-SI-handling <- !tick-char !vowel ( EOF / spaces / &SI )
post-cmavo-no-BU-handling <- !tick-char !vowel ( spacing-no-BU-handling-opt / &BU )

pre-cmavo <- BAhE? pre-cmavo-check

; Handling of spaces and things like spaces.
; --- SPACE ---
; Do *NOT* delete the line above!

; SU clauses
su-clause <- (!SU !NIhO !LU !TUhE !TO any-word spacing-no-absorb-opt)+ SU / SU

; Handling of SI and interactions with zo and lo'u...le'u

si-clause <- (Y BU SI SI / ZO-no-SI-handling SI SI SI / zo-clause-no-SI-handling SI SI / LOhU lohu-tail-si-clause SI / ZOI SI / ZOI zoi-clause-no-SI-handling SI SI SI SI / !SI !SA all-sa-clauses CMAVO-no-SA-handling SI / !SA !ZOI !LOhU !SI !ZO any-word-no-SI-handling SI / !SA !ZOI !LOhU !SI !ZO any-word-no-SI-handling si-clause SI )*

lohu-tail-si-clause <- LEhU-no-SI-handling si-clause SI / !SI any-word-no-SI-handling lohu-tail-si-clause SI

zo-si-clause <- Y BU+ SI zo-si-clause / any-word-no-SI-handling SI !SI / any-word-no-SI-handling zo-si-clause SI !SI

zo-clause-no-SI-handling <- ZO !SI any-word spacing-no-absorb-opt

zoi-spacing-opt <- spaces?

zoi-spacing <- EOF / space-chars+

; The SI behaviour we want with ZOI is that SI does not work inside the delimiters
; (obviously), the delimiters take one SI each to remove, and the stuff inside the
; delimiters takes one SI to remove, no matter how long it is.
;
; This means there are a bunch of cases, and we just handle them individually with the appropriate number of trailing SI

zoi-si-start <- any-word-zoi &{ myAssign( new String(anyWordZoiSEP1.toString()) ) } zoi-first-word? zoi-words-no-SI-handling si-clause SI SI SI

zoi-si-middle <- zoi-first-word? zoi-words-no-SI-handling si-clause SI SI

zoi-si-end <- zoi-last-word si-clause SI

; ****
; End ZOI
; ****

; *** END ZOI SI clause section

; --- MORPHOLOGY ---
; Do *NOT* delete the line above!

; This section handles things that are morphological, i.e. that break down on a per-character basis.


;         any single lexable Lojban words 
any-word <- CMAVO-no-absorb / BRIVLA-no-absorb / CMENE-no-absorb
any-word-zoi <- !SI !SA !SU !ZEI !Y ( CMAVO-zoi / BRIVLA-zoi / CMENE-zoi )
any-word-SA-handling <- CMAVO / BRIVLA / CMENE
any-word-no-SI-handling <- CMAVO-no-SI-handling / BRIVLA-no-SI-handling / CMENE-no-SI-handling
any-word-no-SA-handling <- CMAVO-no-SA-handling / BRIVLA-no-SI-handling / CMENE-no-SI-handling
any-word-no-BU-handling <- CMAVO-no-BU-handling / BRIVLA-no-BU-handling / CMENE-no-BU-handling

;; -- General Morphology Issues
;
; 1.  Spaces (including '.y') and UI are eaten *after* a word.
;
; 2.  Morphology is checked *before* a word.
;
; 3.  BAhE is eaten *before* a word.
;
; 4.  <selma'o>-words should be used only in those situations where
;	we are Really Sure that we don't need to worry about morphology.  In other words, basically never.

;; -- Letter Groups
NORATS consonant <- [bcdfgjklmnprstvxz]
NORATS initial-pair <- "bl" /  "br" /  "cf" /  "ck" /  "cl" /  "cm" /  "cn" /  "cp" /  "cr" /  "ct" /  "dj" /  "dr" /  "dz" /  "fl" /  "fr" /  "gl" /  "gr" /  "jb" /  "jd" /  "jg" /  "jm" /  "jv" /  "kl" /  "kr" /  "ml" /  "mr" /  "pl" /  "pr" /  "sf" /  "sk" /  "sl" /  "sm" /  "sn" /  "sp" /  "sr" /  "st" /  "tc" /  "tr" /  "ts" /  "vl" /  "vr" /  "xl" /  "xr" /  "zb" /  "zd" /  "zg" /  "zm" /  "zv"
NORATS cmene-consonant <- [bcdfgjklmnprstvxz] / [BCDFGJKLMNPRSTVXZ]
NORATS vowel <- [aeiouy]
NORATS vowel-not-y <- [aeiou]
NORATS y-char <- 'y'
NORATS tick-char <- [']
NORATS other-letter <- [',]
NORATS dot-star <- .*
NORATS other-cmene-letters <- [BCDFGJKLMNPRSTVXZ] / [AEIOU] / [hY]
NORATS number-char <- [0123456789]
NORATS EOF <- !.

any-letter <- cmene-letter / number-char
lojban-letter <- consonant / vowel / otherLetter
cmene-letter <- lojban-letter / other-cmene-letters

; Characters we recognize as spaces.
SPACE space-chars <- space-chars-real
NORATS space-chars-real <- '.' / ' ' / '\n' / '\t' / '\r' / '?' / '!'

;; CMAVO morphology
CMAVO-post-morphology <- &spaces / CMAVO-cmene-check (CMAVO-brivla-check / CMAVO-consonant-check)
CMAVO-brivla-check <- &(consonant? vowel (tick-char vowel / vowel)* initial-pair vowel lojban-letter lojban-letter) 

CMAVO-cmene-check <- !( cmene-letter CMAVO-cmene-check-tail )
CMAVO-cmene-check-tail <- consonant &spaces / cmene-letter CMAVO-cmene-check-tail

CMAVO-consonant-check <- !tick-char !( consonant consonant / cmene-letter consonant consonant / cmene-letter cmene-letter consonant consonant / cmene-letter cmene-letter consonant y-char consonant (consonant / vowel-not-y) / cmene-letter cmene-letter cmene-letter consonant consonant )
; The "CMAVO-post" productions only occur after another cmavo as a
; test for whether another cmavo immediately follows, with  no
; intervening spaces; hence must start with consonant.
CMAVO-post <- EOF / (spaces / !vowel) CMAVO-post-morphology known-cmavo / !vowel CMAVO-post-morphology consonant vowel (tick-char vowel / vowel)+
CMAVO-post-no-SI-handling <- EOF / !vowel CMAVO-post-morphology consonant vowel (tick-char vowel / vowel)*
CMAVO-post-no-BU-handling <- EOF / !vowel CMAVO-post-morphology consonant vowel (tick-char vowel / vowel)*

; The basic 'CMAVO' production is a bit special, in that all single-vowel cmavo are handled by the first section.
CMAVO <- pre-cmavo-check known-cmavo / pre-cmavo-check consonant? vowel (tick-char vowel / vowel)+ spacing !BU-bare

CMAVO-letters <- number-char+ / consonant? vowel (tick-char vowel / vowel)*
CMAVO-zoi <- pre-cmavo-check CMAVO-letters &zoi-spacing-opt
CMAVO-no-absorb <- pre-cmavo-check CMAVO-letters &spacing-no-absorb-opt !BU-bare / BU
CMAVO-no-SI-handling <- pre-cmavo-check CMAVO-letters post-cmavo-no-SI-handling
CMAVO-no-SA-handling <- pre-cmavo-check CMAVO-letters post-cmavo-no-SA-handling
CMAVO-no-BU-handling <- pre-cmavo-check CMAVO-letters post-cmavo-no-BU-handling

known-cmavo <- A / BAI / BAhE / BE / BEI / BEhO / BIhE / BIhI / BO / BOI / BU / BY / CAI / CAhA / CEI / CEhE / CO / COI / CU / CUhE / DAhO / DOI / DOhU / FA / FAhA / FAhO / FEhE / FEhU / FIhO / FOI / FUhA / FUhE / FUhO / GA / GAhO / GEhU / GI / GIhA / GOI / GOhA / GUhA / I / JA / JAI / JOI / JOhI / KE / KEI / KEhE / KI / KOhA / KU / KUhE / KUhO / LA / LAU / LAhE / LE / LEhU / LI / LIhU / LOhO / LOhU / LU / LUhU / MAI / MAhO / ME / MEhU / MOI / MOhE / MOhI / NA / NAI / NAhE / NAhU / NIhE / NIhO / NOI / NU / NUhA / NUhI / NUhU / PA / PEhE / PEhO / PU / RAhO / ROI / SA / SE / SEI / SEhU / SI / SOI / SU / TAhE / TEI / TEhU / TO / TOI / TUhE / TUhU / UI / VA / VAU / VEI / VEhA / VEhO / VIhA / VUhO / VUhU / XI / Y / ZAhO / ZEI / ZEhA / ZI / ZIhE / ZO / ZOI / ZOhU

all-sa-clauses <- A-sa-clause / BAI-sa-clause / BE-sa-clause / BEI-sa-clause / BEhO-sa-clause / BIhE-sa-clause / BIhI-sa-clause / BO-sa-clause / BOI-sa-clause / BY-sa-clause / CAhA-sa-clause / CAI-sa-clause / CEI-sa-clause / CEhE-sa-clause / CO-sa-clause / COI-sa-clause / CU-sa-clause / CUhE-sa-clause / DAhO-sa-clause / DOI-sa-clause / DOhU-sa-clause / FA-sa-clause / FAhA-sa-clause / FAhO-sa-clause / FEhE-sa-clause / FEhU-sa-clause / FIhO-sa-clause / FOI-sa-clause / FUhA-sa-clause / FUhE-sa-clause / FUhO-sa-clause / GA-sa-clause / GAhO-sa-clause / GEhU-sa-clause / GI-sa-clause / GIhA-sa-clause / GOI-sa-clause / GOhA-sa-clause / GUhA-sa-clause / I-sa-clause / JA-sa-clause / JAI-sa-clause / JOhI-sa-clause / JOI-sa-clause / KE-sa-clause / KEhE-sa-clause / KEI-sa-clause / KI-sa-clause / KOhA-sa-clause / KU-sa-clause / KUhE-sa-clause / KUhO-sa-clause / LA-sa-clause / LAU-sa-clause / LAhE-sa-clause / LE-sa-clause / LEhU-sa-clause / LI-sa-clause / LIhU-sa-clause / LOhO-sa-clause / LU-sa-clause / LUhU-sa-clause / MAhO-sa-clause / MAI-sa-clause / ME-sa-clause / MEhU-sa-clause / MOhE-sa-clause / MOhI-sa-clause / MOI-sa-clause / NA-sa-clause / NAI-sa-clause / NAhE-sa-clause / NAhU-sa-clause / NIhE-sa-clause / NIhO-sa-clause / NOI-sa-clause / NU-sa-clause / NUhA-sa-clause / NUhI-sa-clause / NUhU-sa-clause / PA-sa-clause / PEhE-sa-clause / PEhO-sa-clause / PU-sa-clause / RAhO-sa-clause / ROI-sa-clause / SE-sa-clause / SEI-sa-clause / SEhU-sa-clause / SOI-sa-clause / SU-sa-clause / TAhE-sa-clause / TEhU-sa-clause / TEI-sa-clause / TO-sa-clause / TOI-sa-clause / TUhE-sa-clause / TUhU-sa-clause / UI-sa-clause / VA-sa-clause / VAU-sa-clause / VEI-sa-clause / VEhO-sa-clause / VUhU-sa-clause / VEhA-sa-clause / VIhA-sa-clause / VUhO-sa-clause / XI-sa-clause / Y-sa-clause / ZAhO-sa-clause / ZEhA-sa-clause / ZEI-sa-clause / ZI-sa-clause / ZIhE-sa-clause /ZOI-sa-clause / ZOhU-sa-clause

;         any brivla 
; For now: gismu pattern.
; BRIVLA	: /[bcdfgjklmnprstvxz]{2}['a-z]{2,}[aeiou]/
;		/ /[bcdfgjklmnprstvxz][aeiou][bcdfgjklmnprstvxz]y?[bcdfgjklmnprstvxz]['a-z]*[aeiou]/
;		/ /[bcdfgjklmnprstvxz][aeiou]'?[aeiou][bcdfgjklmnprstvxz]{2}['a-z]*[aeiou]/
;		/ /[aeiou]('?[aeiou]){,2}[bcdfgjklmnprstvxz]{2}['a-z]*[aeiou]/

BRIVLA <- BAhE? initial-pair lojban-letter lojban-letter brivla-tail / BAhE? consonant !y-char vowel consonant y-char? consonant brivla-tail / BAhE? consonant !y-char vowel tick-char? !y-char vowel consonant consonant brivla-tail
;/ FUHIVLA

BRIVLA-no-absorb <- BAhE? initial-pair lojban-letter lojban-letter brivla-tail-no-absorb / BAhE? consonant !y-char vowel consonant y-char? consonant brivla-tail-no-absorb / BAhE? consonant !y-char vowel tick-char? !y-char vowel consonant consonant brivla-tail-no-absorb
brivla-tail-no-absorb <- vowel-not-y &spacing-no-absorb / lojban-letter brivla-tail-no-absorb

BRIVLA-zoi <- initial-pair lojban-letter lojban-letter brivla-tail-no-absorb / consonant !y-char vowel consonant y-char? consonant brivla-tail-no-absorb / consonant !y-char vowel tick-char? !y-char vowel consonant consonant brivla-tail-no-absorb

; FUHIVLA <- !tick-char consonant consonant brivla-tail / !CMAVO cmene-letter consonant consonant brivla-tail / !CMAVO cmene-letter cmene-letter consonant consonant brivla-tail / cmene-letter cmene-letter consonant y-char consonant (consonant / vowel-not-y) brivla-tail / cmene-letter cmene-letter cmene-letter consonant consonant brivla-tail

brivla-tail <- vowel-not-y spacing / lojban-letter brivla-tail

BRIVLA-no-SI-handling <- initial-pair lojban-letter lojban-letter brivla-tail-no-SI-handling / consonant !y-char vowel consonant y-char? consonant brivla-tail-no-SI-handling / consonant !y-char vowel tick-char? !y-char vowel consonant consonant brivla-tail-no-SI-handling

brivla-tail-no-SI-handling <- vowel-not-y spacing-no-SI-handling / lojban-letter brivla-tail-no-SI-handling

BRIVLA-no-BU-handling <- initial-pair lojban-letter lojban-letter brivla-tail-no-BU-handling / consonant !y-char vowel consonant y-char? consonant brivla-tail-no-BU-handling / consonant !y-char vowel tick-char? !y-char vowel consonant consonant brivla-tail-no-BU-handling

brivla-tail-no-BU-handling <- vowel-not-y spacing-no-BU-handling / lojban-letter brivla-tail-no-BU-handling

; CMENE <- /\.?[,'a-pr-z]+[bcdfgjklmnprstvxz]/
CMENE <- BAhE? cmene-letter cmene-tail

cmene-tail <- cmene-consonant !y-char spacing / cmene-letter cmene-tail

CMENE-zoi <- cmene-letter cmene-tail-no-absorb

CMENE-no-absorb <- BAhE? cmene-letter cmene-tail-no-absorb
cmene-tail-no-absorb <- cmene-consonant !y-char &spacing-no-absorb / cmene-letter cmene-tail-no-absorb

CMENE-no-SI-handling <- cmene-letter cmene-tail-no-SI-handling

cmene-tail-no-SI-handling <- cmene-consonant !y-char spacing-no-SI-handling / cmene-letter cmene-tail-no-SI-handling

CMENE-no-BU-handling <- cmene-letter cmene-tail-no-BU-handling
cmene-tail-no-BU-handling <- cmene-consonant !y-char spacing-no-BU-handling / cmene-letter cmene-tail-no-BU-handling



; --- SELMAHO ---
; Do *NOT* delete the line above!

; The selma'o section is of type SPACE because the end user does not, in fact, want to see anything of the SA handling and so-on; only the words themselves should be visible.

; Listing of productions for the individual selma'o

;         eks; basic afterthought logical connectives 
MORPHOLOGY A <- A-pre A-words A-post
A-pre <- pre-cmavo A-sa-clause?
A-post <- post-cmavo
SPACE A-no-SA-handling <- pre-cmavo A-words post-cmavo
SPACE A-sa-clause <- A-no-SA-handling A-sa-tail
SPACE A-sa-tail <- SA &A-no-SA-handling / !A-no-SA-handling !SA any-word-no-SA-handling A-sa-tail / A-no-SA-handling A-sa-tail2 A-sa-tail
SPACE A-sa-tail2 <- SA / !A-no-SA-handling !SA any-word-no-SA-handling A-sa-tail2 / A-no-SA-handling A-sa-tail2 A-sa-tail2
NORATS A-words <- "a" / "e" / "ji" / "o" / "u"


;         modal operators 
MORPHOLOGY BAI <- BAI-pre BAI-words BAI-post
BAI-pre <- pre-cmavo BAI-sa-clause?
BAI-post <- post-cmavo
SPACE BAI-no-SA-handling <- pre-cmavo BAI-words post-cmavo
SPACE BAI-sa-clause <- BAI-no-SA-handling BAI-sa-tail
SPACE BAI-sa-tail <- SA &BAI-no-SA-handling / !BAI-no-SA-handling !SA any-word-no-SA-handling BAI-sa-tail / BAI-no-SA-handling BAI-sa-tail2 BAI-sa-tail
SPACE BAI-sa-tail2 <- SA / !BAI-no-SA-handling !SA any-word-no-SA-handling BAI-sa-tail2 / BAI-no-SA-handling BAI-sa-tail2 BAI-sa-tail2
NORATS BAI-words <- "du'o" / "si'u" / "zau" / "ki'i" / "du'i" / "cu'u" / "tu'i" / "ti'u" / "di'o" / "ji'u" / "ri'a" / "ni'i" / "mu'i" / "ki'u" / "va'u" / "koi" / "ca'i" / "ta'i" / "pu'e" / "ja'i" / "kai" / "bai" / "fi'e" / "de'i" / "ci'o" / "mau" / "mu'u" / "ri'i" / "ra'i" / "ka'a" / "pa'u" / "pa'a" / "le'a" / "ku'u" / "tai" / "bau" / "ma'i" / "ci'e" / "fau" / "po'i" / "cau" / "ma'e" / "ci'u" / "ra'a" / "pu'a" / "li'e" / "la'u" / "ba'i" / "ka'i" / "sau" / "fa'e" / "be'i" / "ti'i" / "ja'e" / "ga'a" / "va'o" / "ji'o" / "me'a" / "do'e" / "ji'e" / "pi'o" / "gau" / "zu'e" / "me'e" / "rai"

;         next word intensifier 
BAhE <- (pre-cmavo-check BAhE-words spaces?)+
NORATS BAhE-words <- "ba'e" / "za'e"

;         sumti link to attach sumti to a selbri 
MORPHOLOGY BE <- BE-pre BE-words BE-post
BE-pre <- pre-cmavo BE-sa-clause?
BE-post <- post-cmavo
SPACE BE-no-SA-handling <- pre-cmavo BE-words post-cmavo
SPACE BE-sa-clause <- BE-no-SA-handling BE-sa-tail
SPACE BE-sa-tail <- SA &BE-no-SA-handling / !BE-no-SA-handling !SA any-word-no-SA-handling BE-sa-tail / BE-no-SA-handling BE-sa-tail2 BE-sa-tail
SPACE BE-sa-tail2 <- SA / !BE-no-SA-handling !SA any-word-no-SA-handling BE-sa-tail2 / BE-no-SA-handling BE-sa-tail2 BE-sa-tail2
NORATS BE-words <- "be"

;         multiple sumti separator between BE, BEI 
MORPHOLOGY BEI <- BEI-pre BEI-words BEI-post
BEI-pre <- pre-cmavo BEI-sa-clause?
BEI-post <- post-cmavo
SPACE BEI-no-SA-handling <- pre-cmavo BEI-words post-cmavo
SPACE BEI-sa-clause <- BEI-no-SA-handling BEI-sa-tail
SPACE BEI-sa-tail <- SA &BEI-no-SA-handling / !BEI-no-SA-handling !SA any-word-no-SA-handling BEI-sa-tail / BEI-no-SA-handling BEI-sa-tail2 BEI-sa-tail
SPACE BEI-sa-tail2 <- SA / !BEI-no-SA-handling !SA any-word-no-SA-handling BEI-sa-tail2 / BEI-no-SA-handling BEI-sa-tail2 BEI-sa-tail2
NORATS BEI-words <- "bei"

;         terminates BEBEI specified descriptors 
MORPHOLOGY BEhO <- BEhO-pre BEhO-words BEhO-post
BEhO-pre <- pre-cmavo BEhO-sa-clause?
BEhO-post <- post-cmavo
SPACE BEhO-no-SA-handling <- pre-cmavo BEhO-words post-cmavo
SPACE BEhO-sa-clause <- BEhO-no-SA-handling BEhO-sa-tail
SPACE BEhO-sa-tail <- SA &BEhO-no-SA-handling / !BEhO-no-SA-handling !SA any-word-no-SA-handling BEhO-sa-tail / BEhO-no-SA-handling BEhO-sa-tail2 BEhO-sa-tail
SPACE BEhO-sa-tail2 <- SA / !BEhO-no-SA-handling !SA any-word-no-SA-handling BEhO-sa-tail2 / BEhO-no-SA-handling BEhO-sa-tail2 BEhO-sa-tail2
NORATS BEhO-words <- "be'o"

;         prefix for high-priority MEX operator 
MORPHOLOGY BIhE <- BIhE-pre BIhE-words BIhE-post
BIhE-pre <- pre-cmavo BIhE-sa-clause?
BIhE-post <- post-cmavo
SPACE BIhE-no-SA-handling <- pre-cmavo BIhE-words post-cmavo
SPACE BIhE-sa-clause <- BIhE-no-SA-handling BIhE-sa-tail
SPACE BIhE-sa-tail <- SA &BIhE-no-SA-handling / !BIhE-no-SA-handling !SA any-word-no-SA-handling BIhE-sa-tail / BIhE-no-SA-handling BIhE-sa-tail2 BIhE-sa-tail
SPACE BIhE-sa-tail2 <- SA / !BIhE-no-SA-handling !SA any-word-no-SA-handling BIhE-sa-tail2 / BIhE-no-SA-handling BIhE-sa-tail2 BIhE-sa-tail2
NORATS BIhE-words <- "bi'e"

;         interval component of JOI 
MORPHOLOGY BIhI <- BIhI-pre BIhI-words BIhI-post
BIhI-pre <- pre-cmavo BIhI-sa-clause?
BIhI-post <- post-cmavo
SPACE BIhI-no-SA-handling <- pre-cmavo BIhI-words post-cmavo
SPACE BIhI-sa-clause <- BIhI-no-SA-handling BIhI-sa-tail
SPACE BIhI-sa-tail <- SA &BIhI-no-SA-handling / !BIhI-no-SA-handling !SA any-word-no-SA-handling BIhI-sa-tail / BIhI-no-SA-handling BIhI-sa-tail2 BIhI-sa-tail
SPACE BIhI-sa-tail2 <- SA / !BIhI-no-SA-handling !SA any-word-no-SA-handling BIhI-sa-tail2 / BIhI-no-SA-handling BIhI-sa-tail2 BIhI-sa-tail2
NORATS BIhI-words <- "mi'i" / "bi'o" / "bi'i"

;         joins two units with shortest scope 
MORPHOLOGY BO <- BO-pre BO-words BO-post
BO-pre <- pre-cmavo BO-sa-clause?
BO-post <- post-cmavo
SPACE BO-no-SA-handling <- pre-cmavo BO-words post-cmavo
SPACE BO-sa-clause <- BO-no-SA-handling BO-sa-tail
SPACE BO-sa-tail <- SA &BO-no-SA-handling / !BO-no-SA-handling !SA any-word-no-SA-handling BO-sa-tail / BO-no-SA-handling BO-sa-tail2 BO-sa-tail
SPACE BO-sa-tail2 <- SA / !BO-no-SA-handling !SA any-word-no-SA-handling BO-sa-tail2 / BO-no-SA-handling BO-sa-tail2 BO-sa-tail2
NORATS BO-words <- "bo"

;         number or lerfu-string terminator 
MORPHOLOGY BOI <- BOI-pre BOI-words BOI-post
BOI-pre <- pre-cmavo BOI-sa-clause?
BOI-post <- post-cmavo
SPACE BOI-no-SA-handling <- pre-cmavo BOI-words post-cmavo
SPACE BOI-sa-clause <- BOI-no-SA-handling BOI-sa-tail
SPACE BOI-sa-tail <- SA &BOI-no-SA-handling / !BOI-no-SA-handling !SA any-word-no-SA-handling BOI-sa-tail / BOI-no-SA-handling BOI-sa-tail2 BOI-sa-tail
SPACE BOI-sa-tail2 <- SA / !BOI-no-SA-handling !SA any-word-no-SA-handling BOI-sa-tail2 / BOI-no-SA-handling BOI-sa-tail2 BOI-sa-tail2
NORATS BOI-words <- "boi"

;         turns any word into a BY lerfu word 
MORPHOLOGY BU <- BU-pre BU-words BU-post
BU-pre <- pre-cmavo-check
BU-post <- post-cmavo-no-BU-handling
NORATS BU-words <- "bu"
BU-bare <- pre-cmavo-check BU-words !tick-char !vowel spacing-opt

;         individual lerfu words 
MORPHOLOGY BY <- BY-pre BY-words BY-post
BY-pre <- pre-cmavo BY-sa-clause?
BY-post <- post-cmavo
SPACE BY-no-SA-handling <- pre-cmavo BY-words post-cmavo
SPACE BY-sa-clause <- BY-no-SA-handling BY-sa-tail
SPACE BY-sa-tail <- SA &BY-no-SA-handling / !BY-no-SA-handling !SA any-word-no-SA-handling BY-sa-tail / BY-no-SA-handling BY-sa-tail2 BY-sa-tail
SPACE BY-sa-tail2 <- SA / !BY-no-SA-handling !SA any-word-no-SA-handling BY-sa-tail2 / BY-no-SA-handling BY-sa-tail2 BY-sa-tail2
NORATS BY-words <- "jo'o" / "ru'o" / "ge'o" / "je'o" / "lo'a" / "na'a" / "se'e" / "to'a" / "ga'e" / "y'y" / "by" / "cy" / "dy" / "fy" / "gy" / "jy" / "ky" / "ly" / "my" / "ny" / "py" / "ry" / "sy" / "ty" / "vy" / "xy" / "zy"


;         specifies actualitypotentiality of tense 
MORPHOLOGY CAhA <- CAhA-pre CAhA-words CAhA-post
CAhA-pre <- pre-cmavo CAhA-sa-clause?
CAhA-post <- post-cmavo
SPACE CAhA-no-SA-handling <- pre-cmavo CAhA-words post-cmavo
SPACE CAhA-sa-clause <- CAhA-no-SA-handling CAhA-sa-tail
SPACE CAhA-sa-tail <- SA &CAhA-no-SA-handling / !CAhA-no-SA-handling !SA any-word-no-SA-handling CAhA-sa-tail / CAhA-no-SA-handling CAhA-sa-tail2 CAhA-sa-tail
SPACE CAhA-sa-tail2 <- SA / !CAhA-no-SA-handling !SA any-word-no-SA-handling CAhA-sa-tail2 / CAhA-no-SA-handling CAhA-sa-tail2 CAhA-sa-tail2
NORATS CAhA-words <- "ca'a" / "pu'i" / "nu'o" / "ka'e"

;         afterthought intensity marker 
MORPHOLOGY CAI <- CAI-pre CAI-words CAI-post
CAI-pre <- pre-cmavo CAI-sa-clause?
CAI-post <- post-cmavo
SPACE CAI-no-SA-handling <- pre-cmavo CAI-words post-cmavo
SPACE CAI-sa-clause <- CAI-no-SA-handling CAI-sa-tail
SPACE CAI-sa-tail <- SA &CAI-no-SA-handling / !CAI-no-SA-handling !SA any-word-no-SA-handling CAI-sa-tail / CAI-no-SA-handling CAI-sa-tail2 CAI-sa-tail
SPACE CAI-sa-tail2 <- SA / !CAI-no-SA-handling !SA any-word-no-SA-handling CAI-sa-tail2 / CAI-no-SA-handling CAI-sa-tail2 CAI-sa-tail2
NORATS CAI-words <- "pei" / "cai" / "cu'i" / "sai" / "ru'e"

;         pro-bridi assignment operator 
MORPHOLOGY CEI <- CEI-pre CEI-words CEI-post
CEI-pre <- pre-cmavo CEI-sa-clause?
CEI-post <- post-cmavo
SPACE CEI-no-SA-handling <- pre-cmavo CEI-words post-cmavo
SPACE CEI-sa-clause <- CEI-no-SA-handling CEI-sa-tail
SPACE CEI-sa-tail <- SA &CEI-no-SA-handling / !CEI-no-SA-handling !SA any-word-no-SA-handling CEI-sa-tail / CEI-no-SA-handling CEI-sa-tail2 CEI-sa-tail
SPACE CEI-sa-tail2 <- SA / !CEI-no-SA-handling !SA any-word-no-SA-handling CEI-sa-tail2 / CEI-no-SA-handling CEI-sa-tail2 CEI-sa-tail2
NORATS CEI-words <- "cei"

;         afterthought term list connective 
MORPHOLOGY CEhE <- CEhE-pre CEhE-words CEhE-post
CEhE-pre <- pre-cmavo CEhE-sa-clause?
CEhE-post <- post-cmavo
SPACE CEhE-no-SA-handling <- pre-cmavo CEhE-words post-cmavo
SPACE CEhE-sa-clause <- CEhE-no-SA-handling CEhE-sa-tail
SPACE CEhE-sa-tail <- SA &CEhE-no-SA-handling / !CEhE-no-SA-handling !SA any-word-no-SA-handling CEhE-sa-tail / CEhE-no-SA-handling CEhE-sa-tail2 CEhE-sa-tail
SPACE CEhE-sa-tail2 <- SA / !CEhE-no-SA-handling !SA any-word-no-SA-handling CEhE-sa-tail2 / CEhE-no-SA-handling CEhE-sa-tail2 CEhE-sa-tail2
NORATS CEhE-words <- "ce'e"

;         names; require consonant end, then pause no

;                                    LA or DOI selma'o embedded, pause before if

;                                    vowel initial and preceded by a vowel 

;         tanru inversion  
MORPHOLOGY CO <- CO-pre CO-words CO-post
CO-pre <- pre-cmavo CO-sa-clause?
CO-post <- post-cmavo
SPACE CO-no-SA-handling <- pre-cmavo CO-words post-cmavo
SPACE CO-sa-clause <- CO-no-SA-handling CO-sa-tail
SPACE CO-sa-tail <- SA &CO-no-SA-handling / !CO-no-SA-handling !SA any-word-no-SA-handling CO-sa-tail / CO-no-SA-handling CO-sa-tail2 CO-sa-tail
SPACE CO-sa-tail2 <- SA / !CO-no-SA-handling !SA any-word-no-SA-handling CO-sa-tail2 / CO-no-SA-handling CO-sa-tail2 CO-sa-tail2
NORATS CO-words <- "co"
MORPHOLOGY COI <- COI-pre COI-words COI-post
COI-pre <- pre-cmavo COI-sa-clause?
COI-post <- post-cmavo
SPACE COI-no-SA-handling <- pre-cmavo COI-words post-cmavo
SPACE COI-sa-clause <- COI-no-SA-handling COI-sa-tail
SPACE COI-sa-tail <- SA &COI-no-SA-handling / !COI-no-SA-handling !SA any-word-no-SA-handling COI-sa-tail / COI-no-SA-handling COI-sa-tail2 COI-sa-tail
SPACE COI-sa-tail2 <- SA / !COI-no-SA-handling !SA any-word-no-SA-handling COI-sa-tail2 / COI-no-SA-handling COI-sa-tail2 COI-sa-tail2
NORATS COI-words <- "ju'i" / "coi" / "fi'i" / "ta'a" / "mu'o" / "fe'o" / "co'o" / "pe'u" / "ke'o" / "nu'e" / "re'i" / "be'e" / "je'e" / "mi'e" / "ki'e" / "vi'o"

;         vocative marker permitted inside names; must

;                                    always be followed by pause or DOI 

;         separator between head sumti and selbri 
MORPHOLOGY CU <- CU-pre CU-words CU-post
CU-pre <- pre-cmavo CU-sa-clause?
CU-post <- post-cmavo
SPACE CU-no-SA-handling <- pre-cmavo CU-words post-cmavo
SPACE CU-sa-clause <- CU-no-SA-handling CU-sa-tail
SPACE CU-sa-tail <- SA &CU-no-SA-handling / !CU-no-SA-handling !SA any-word-no-SA-handling CU-sa-tail / CU-no-SA-handling CU-sa-tail2 CU-sa-tail
SPACE CU-sa-tail2 <- SA / !CU-no-SA-handling !SA any-word-no-SA-handling CU-sa-tail2 / CU-no-SA-handling CU-sa-tail2 CU-sa-tail2
NORATS CU-words <- "cu"

;         tensemodal question 
MORPHOLOGY CUhE <- CUhE-pre CUhE-words CUhE-post
CUhE-pre <- pre-cmavo CUhE-sa-clause?
CUhE-post <- post-cmavo
