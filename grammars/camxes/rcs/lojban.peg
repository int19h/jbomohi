ZEI-no-SA-handling <- pre-cmavo ZEI-words post-cmavo
ZEI-sa-clause <- ZEI-words spaces* ZEI-sa-tail
ZEI-sa-tail <- SA &(pre-cmavo ZEI-words) / !ZEI-words any-word-no-SA-handling ZEI-sa-tail
