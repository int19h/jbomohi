; SU clauses
su-clause <- (!SU-clause !NIhO-clause !LU-clause !TUhE-clause !TO-clause any-word spacing-no-absorb-opt)+ SU-clause / SU-clause

; Handling of SI and interactions with zo and lo'u...le'u

SPACE si-clause <- (Y BU-clause SI-clause SI-clause / ZO-no-SI-handling SI-clause SI-clause SI-clause / zo-clause-no-SI-handling SI-clause SI-clause / LOhU-clause lohu-tail-si-clause SI-clause / ZOI-clause SI-clause / zoi-clause-no-SI-handling SI-clause SI-clause SI-clause SI-clause / !SI-clause !SA-clause all-sa-clauses CMAVO-no-SA-handling SI-clause / !SA-clause !ZOI-clause !LOhU-clause !SI-clause !ZO-clause any-word-no-SI-handling SI-clause / !SA-clause !ZOI-clause !LOhU-clause !SI-clause !ZO-clause any-word-no-SI-handling si-clause SI-clause )*

lohu-tail-si-clause <- LEhU-no-SI-handling si-clause SI-clause / !SI-clause any-word-no-SI-handling lohu-tail-si-clause SI-clause

zo-si-clause <- Y-clause BU-clause+ SI-clause zo-si-clause / any-word-no-SI-handling SI-clause !SI-clause / any-word-no-SI-handling zo-si-clause SI-clause !SI-clause

zo-clause-no-SI-handling <- ZO-clause !SI-clause any-word spacing-no-absorb-opt

; The SI behaviour we want with ZOI is that SI does not work inside the delimiters
; (obviously), the delimiters take one SI each to remove, and the stuff inside the
; delimiters takes one SI to remove, no matter how long it is.
;
; This means there are a bunch of cases, and we just handle them individually with the appropriate number of trailing SI

zoi-si-start <- any-word-zoi &{ myAssign( new String(anyWordZoiSEP1.toString()) ) } zoi-first-word? zoi-words-no-SI-handling si-clause SI-clause SI-clause SI-clause

zoi-si-middle <- zoi-first-word? zoi-words-no-SI-handling si-clause SI-clause SI-clause

zoi-si-end <- zoi-last-word si-clause SI-clause

; ****
; End ZOI
; ****

; *** END ZOI SI clause section


