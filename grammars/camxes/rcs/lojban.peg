NORATS XI-words <- "xi"


;         hesitation 
MORPHOLOGY Y <- Y-pre Y-words Y-post
Y-pre <- pre-cmavo Y-sa-clause?
Y-post <- Y-post-cmavo
Y-post-cmavo <- si-clause (space-chars+ / !tick-char !vowel) !ZEI
SPACE Y-no-SA-handling <- pre-cmavo Y-words post-cmavo
; Y+SA clause makes no sense
SPACE Y-sa-clause <- EOF
;Y-sa-clause <- Y-no-SA-handling Y-sa-tail
;Y-sa-tail <- SA &Y-no-SA-handling / !Y-no-SA-handling !SA any-word-no-SA-handling Y-sa-tail / Y-no-SA-handling Y-sa-tail2 Y-sa-tail
;Y-sa-tail2 <- SA / !Y-no-SA-handling !SA any-word-no-SA-handling Y-sa-tail2 / Y-no-SA-handling Y-sa-tail2 Y-sa-tail2
NORATS Y-words <- "y"+


