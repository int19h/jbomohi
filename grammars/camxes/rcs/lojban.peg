VEhA-words <- "ve'u" / "ve'a" / "ve'i" / "ve'e"
;         space-time dimensionality marker 
VIhA <- pre-cmavo VIhA-sa-clause? VIhA-words post-cmavo
VIhA-no-SA-handling <- pre-cmavo VIhA-words post-cmavo
VIhA-sa-clause <- VIhA-words spaces* VIhA-sa-tail
VIhA-sa-tail <- SA &(pre-cmavo VIhA-words) / !VIhA-words any-word-no-SA-handling VIhA-sa-tail
VIhA-words <- "vi'i" / "vi'a" / "vi'u" / "vi'e"
