;         single word metalinguistic quote marker 
ZO <- pre-cmavo ZO-words zo-post-cmavo
ZO-words <- "zo"
zo-post-cmavo <-  spaces-not-Y+ / &CMAVO-post-no-SI-handling / SI / &BRIVLA
;         delimited quote marker 
ZOI <- pre-cmavo ZOI-sa-clause? ZOI-words post-cmavo
ZOI-no-SA-handling <- pre-cmavo ZOI-words post-cmavo
ZOI-sa-clause <- ZOI-words spaces* ZOI-sa-tail
