;         time distance tense 
ZI <- pre-cmavo ZI-sa-clause? ZI-words post-cmavo
ZI-no-SA-handling <- pre-cmavo ZI-words post-cmavo
ZI-sa-clause <- ZI-words spaces* ZI-sa-tail
