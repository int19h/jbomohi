;         single word metalinguistic quote marker 
MORPHOLOGY ZO <- ZO-pre ZO-words ZO-post
ZO-pre <- pre-cmavo ZO-sa-clause?
ZO-post <- ZO-post-cmavo
ZO-post-cmavo <- !tick-char !vowel si-clause spaces
ZO-no-SI-handling <- pre-cmavo ZO-sa-clause? ZO-words !BU-bare !tick-char !vowel zoi-spacing-opt !ZEI
SPACE ZO-no-SA-handling <- pre-cmavo ZO-words post-cmavo
