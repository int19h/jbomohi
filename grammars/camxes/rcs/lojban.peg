;         subscripting operator 
MORPHOLOGY XI <- XI-pre XI-words XI-post
XI-pre <- pre-cmavo XI-sa-clause?
XI-post <- post-cmavo
SPACE XI-no-SA-handling <- pre-cmavo XI-words post-cmavo
