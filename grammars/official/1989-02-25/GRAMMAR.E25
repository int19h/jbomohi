/* The following rules are used only in lexer processing.  They have been tested
   for ambiguity at various levels in the YACC grammar, but are in the recursive
   descent lexer in the current parser.  The lexer inserts the lexer lexemes
   before the processed strings, but leaves the original tokens. */

lexer.A.905             :  lexer.A.701  indicators.906
                        |  lexer.A.701  FUhE.535  indicators.906
                        ;

indicators.906          :  indicator.907
                        |  indicators.906  indicator.907
                        ;

indicator.907           :  BY.string.A.986  MAI.657
                        |  SA.PA.root.961  MAI.657
