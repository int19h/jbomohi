?- pure(bridi_tail_50,4).
?- pure(ask1,2).
?- pure(permuteQ1,3).
?- pure(deleteQ,6).
?- pure(statement_42,3).
?- pure(tail_terms_71,4).
?- pure(terms_80,6).
?- pure(selbri,5).
?- pure(tanru_unit_B_152,5).
?- pure(se_596,3).
