modal.972               :  modal.A.973
                        |  modal.A.973  KI.554
                        |  KI.554
                        ;
/* KI reassigns the space-time reference to the destination for future tense
   usage or reverts to here/now if not attached to a specified time/space */

modal.A.973             :  modal.B.974
                        |  tense.A.975
                        |  modal.A.973  NAI.578
